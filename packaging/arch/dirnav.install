post_install() {
    echo "==> dirnav instalado com sucesso!"
    echo "    Para adicionar a integracao somente ao seu perfil Bash/Zsh, execute:"
    echo "      dirnav --setup"
    echo "    Depois abra um novo shell ou recarregue seu perfil."
}

post_upgrade() {
    post_install
}

post_remove() {
    echo "==> A remocao do pacote não edita perfis pessoais."
    echo "    Antes de remover o pacote, execute 'dirnav --uninstall'; se ele já foi removido, apague somente o bloco entre os marcadores Dirnav nos perfis afetados."
}
