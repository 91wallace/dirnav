# Maintainer: Wallace Ghiraldelli <wgx7426@gmail.com>
pkgname=dirnav
pkgver=1.0.0
pkgrel=1
pkgdesc="Navegador de diretorios inline ultrarrapido para terminal com busca em tempo real"
arch=('any')
url="https://github.com/91wallace/dirnav"
license=('MIT')
depends=('python')
install=dirnav.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/91wallace/dirnav/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 "dirnav" "$pkgdir/usr/bin/dirnav"
    install -Dm644 "dirnav.sh" "$pkgdir/usr/share/dirnav/dirnav.sh"
    install -Dm644 "dirnav.sh" "$pkgdir/etc/profile.d/dirnav.sh"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
