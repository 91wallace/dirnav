#!/usr/bin/env python3
import contextlib
import os
import shutil
import signal
import sys
import unicodedata

try:
    import select
    import termios
    import tty

    IS_WINDOWS = False
except ImportError:
    import msvcrt

    IS_WINDOWS = True


def normalize_text(text):
    """Remove acentos e normaliza para minusculas para comparacao flexivel."""
    if not text:
        return ""
    nfkd = unicodedata.normalize("NFKD", text)
    return "".join(c for c in nfkd if not unicodedata.combining(c)).lower()


def get_directories(path):
    """Retorna lista ordenada de subpastas visiveis (nao ocultas por '.')."""
    try:
        entries = os.listdir(path)
        dirs = [d for d in entries if os.path.isdir(os.path.join(path, d))]
        dirs = [d for d in dirs if not d.startswith(".")]
        return sorted(dirs, key=str.lower)
    except OSError:
        return []


def filter_directories(dirs, search_query):
    """Filtra a lista de diretorios com base na query (case-insensitive e accent-insensitive)."""
    if not search_query:
        return list(dirs)
    q_lower = search_query.lower()
    q_norm = normalize_text(search_query)
    result = []
    for d in dirs:
        if q_lower in d.lower() or q_norm in normalize_text(d):
            result.append(d)
    return result


def compute_viewport(total_items, selected_idx, scroll_offset, max_lines):
    """
    Calcula de forma deterministica a janela de exibicao (viewport) garantindo
    a invariante: selected_idx SEMPRE pertence a [scroll_offset, scroll_offset + available - 1].
    Retorna: (selected_idx, scroll_offset, available_for_items, has_above, has_below)
    """
    max_lines = max(3, max_lines)
    if total_items <= 0:
        return 0, 0, max_lines, False, False

    selected_idx = max(0, min(selected_idx, total_items - 1))
    scroll_offset = max(0, min(scroll_offset, total_items - 1))

    # Se todos os itens cabem em max_lines sem precisar de scroll
    if total_items <= max_lines:
        return selected_idx, 0, total_items, False, False

    # Garante que scroll_offset nunca fique depois de selected_idx
    scroll_offset = min(scroll_offset, selected_idx)

    # Iteramos para convergir scroll_offset considerando as linhas ocupadas pelos indicadores ↑ e ↓
    for _ in range(4):
        has_above = scroll_offset > 0
        # Se mostrarmos a partir de scroll_offset, quantas linhas sobram se não tiver has_below?
        temp_avail = max_lines - (1 if has_above else 0)
        has_below = (scroll_offset + temp_avail) < total_items
        available_for_items = max(
            1, max_lines - (1 if has_above else 0) - (1 if has_below else 0)
        )

        if selected_idx >= scroll_offset + available_for_items:
            scroll_offset = selected_idx - available_for_items + 1
        elif selected_idx < scroll_offset:
            scroll_offset = selected_idx

        # Se chegamos perto do fim da lista e sobrou espaço vazio, puxa scroll_offset para trás
        has_above = scroll_offset > 0
        has_below = (scroll_offset + available_for_items) < total_items
        available_for_items = max(
            1, max_lines - (1 if has_above else 0) - (1 if has_below else 0)
        )
        if scroll_offset + available_for_items > total_items:
            scroll_offset = max(0, total_items - available_for_items)

    # Recalculo final estrito após estabilização de scroll_offset
    has_above = scroll_offset > 0
    temp_avail = max_lines - (1 if has_above else 0)
    has_below = (scroll_offset + temp_avail) < total_items
    available_for_items = max(
        1, max_lines - (1 if has_above else 0) - (1 if has_below else 0)
    )

    return selected_idx, scroll_offset, available_for_items, has_above, has_below


def build_ui_lines(
    current_path,
    items,
    selected_idx,
    scroll_offset,
    max_lines,
    term_columns,
    search_query="",
):
    """Constroi a lista de linhas formatadas com ANSI para renderizacao."""
    (
        selected_idx,
        scroll_offset,
        available_for_items,
        has_above,
        has_below,
    ) = compute_viewport(len(items), selected_idx, scroll_offset, max_lines)

    lines = []
    max_name_len = max(10, term_columns - 8)

    # Primeira linha: diretorio atual exibido a esquerda (raiz)
    curr_disp = (
        current_path
        if len(current_path) <= max_name_len
        else "..." + current_path[-(max_name_len - 3) :]
    )
    lines.append(f"\033[1;36m📁 {curr_disp}\033[0m")

    # Segunda linha (se houver filtro ativo): barra de pesquisa
    if search_query:
        lines.append(f"   \033[1;33m🔍 Filtro: {search_query}_\033[0m")

    if not items:
        if search_query:
            lines.append(
                f"     \033[90m(nenhum resultado para '{search_query}')\033[0m"
            )
        else:
            lines.append("     \033[90m(nenhuma subpasta)\033[0m")
    else:
        if has_above:
            count_above = scroll_offset
            lines.append(f"     \033[90m↑ +{count_above} acima...\033[0m")

        visible_items = items[scroll_offset : scroll_offset + available_for_items]
        for i, d in enumerate(visible_items):
            actual_idx = scroll_offset + i
            is_selected = actual_idx == selected_idx
            sub_name_len = max(10, term_columns - 10)
            disp_name = d if len(d) <= sub_name_len else d[: sub_name_len - 3] + "..."

            if is_selected:
                lines.append(f"  \033[7m > {disp_name}/ \033[0m")
            else:
                lines.append(f"     \033[1;34m{disp_name}/\033[0m")

        if has_below:
            count_below = len(items) - (scroll_offset + len(visible_items))
            lines.append(f"     \033[90m↓ +{count_below} mais...\033[0m")

    return lines, selected_idx, scroll_offset


def read_key(fd):
    """Le uma tecla do terminal de forma compativel com Windows (UTF-16/UTF-8) e Unix."""
    if IS_WINDOWS:
        # getwch() retorna string Unicode diretamente no Windows, resolvendo acentos e multi-byte
        ch = msvcrt.getwch()
        if ch in ("\x00", "\xe0"):
            ch2 = msvcrt.getwch()
            if ch2 == "H":
                return "UP"
            elif ch2 == "P":
                return "DOWN"
            elif ch2 == "M":
                return "RIGHT"
            elif ch2 == "K":
                return "LEFT"
            elif ch2 == "G":
                return "HOME"
            elif ch2 == "O":
                return "END"
            elif ch2 == "I":
                return "PAGEUP"
            elif ch2 == "Q":
                return "PAGEDOWN"
            elif ch2 == "S":
                return "\b"  # Delete key
            return ""
        if ch == "\x03":
            return "\x03"
        if ch == "\x1b":
            return "ESC"
        if ch in ("\r", "\n"):
            return "\n"
        if ch in ("\x08", "\x7f"):
            return "\b"
        if ch == "\t":
            return "TAB"
        return ch
    else:
        b = os.read(fd, 1)
        if not b:
            return ""
        if b == b"\x03":
            return "\x03"
        if b == b"\x1b":
            r, _, _ = select.select([fd], [], [], 0.15)
            if r:
                b2 = os.read(fd, 1)
                seq = b + b2
                if b2 in (b"[", b"O"):
                    while True:
                        r2, _, _ = select.select([fd], [], [], 0.05)
                        if not r2:
                            break
                        bn = os.read(fd, 1)
                        seq += bn
                        if bn.isalpha() or bn == b"~":
                            break
                if seq in (b"\x1b[A", b"\x1bOA"):
                    return "UP"
                elif seq in (b"\x1b[B", b"\x1bOB"):
                    return "DOWN"
                elif seq in (b"\x1b[C", b"\x1bOC"):
                    return "RIGHT"
                elif seq in (b"\x1b[D", b"\x1bOD"):
                    return "LEFT"
                elif seq in (b"\x1b[H", b"\x1bOH", b"\x1b[1~", b"\x1b[7~"):
                    return "HOME"
                elif seq in (b"\x1b[F", b"\x1bOF", b"\x1b[4~", b"\x1b[8~"):
                    return "END"
                elif seq == b"\x1b[5~":
                    return "PAGEUP"
                elif seq == b"\x1b[6~":
                    return "PAGEDOWN"
                elif seq == b"\x1b[3~":
                    return "\b"
                return ""
            return "ESC"
        if b in (b"\r", b"\n"):
            return "\n"
        if b in (b"\x08", b"\x7f"):
            return "\b"
        if b == b"\t":
            return "TAB"

        # Decodifica sequencias UTF-8 multi-byte no Unix
        first_byte = b[0]
        extra_bytes = 0
        if (first_byte & 0xE0) == 0xC0:
            extra_bytes = 1
        elif (first_byte & 0xF0) == 0xE0:
            extra_bytes = 2
        elif (first_byte & 0xF8) == 0xF0:
            extra_bytes = 3

        for _ in range(extra_bytes):
            r_utf, _, _ = select.select([fd], [], [], 0.05)
            if r_utf:
                b += os.read(fd, 1)

        return b.decode("utf-8", errors="replace")


class NavigatorState:
    """Maquina de estados desacoplada para navegacao e filtragem de diretorios."""

    def __init__(self, start_path, max_lines=8):
        self.current_path = os.path.abspath(start_path)
        self.search_query = ""
        self.selected_idx = 0
        self.scroll_offset = 0
        self.max_lines = max_lines
        self.cancelled = False
        self.finished = False
        self.target_path = None
        self.all_dirs = []
        self.filtered_dirs = []
        self.refresh_dirs()

    def refresh_dirs(self):
        self.all_dirs = get_directories(self.current_path)
        self.apply_filter()

    def apply_filter(self):
        self.filtered_dirs = filter_directories(self.all_dirs, self.search_query)
        (
            self.selected_idx,
            self.scroll_offset,
            _,
            _,
            _,
        ) = compute_viewport(
            len(self.filtered_dirs),
            self.selected_idx,
            self.scroll_offset,
            self.max_lines,
        )

    def handle_key(self, key):
        """Processa uma tecla e atualiza o estado."""
        if not key:
            return

        if key == "UP":
            if self.selected_idx > 0:
                self.selected_idx -= 1
                self.apply_filter()

        elif key == "DOWN":
            if self.selected_idx < len(self.filtered_dirs) - 1:
                self.selected_idx += 1
                self.apply_filter()

        elif key == "LEFT":
            # Seta para a esquerda: sobe para o diretorio pai e limpa a pesquisa
            parent = os.path.dirname(self.current_path)
            if parent and parent != self.current_path:
                self.current_path = parent
                self.search_query = ""
                self.selected_idx = 0
                self.scroll_offset = 0
                self.refresh_dirs()

        elif key in ("RIGHT", "TAB"):
            # Seta para a direita ou TAB: entra na subpasta selecionada
            if self.filtered_dirs and 0 <= self.selected_idx < len(self.filtered_dirs):
                new_path = os.path.join(
                    self.current_path, self.filtered_dirs[self.selected_idx]
                )
                if os.path.isdir(new_path):
                    self.current_path = new_path
                    self.search_query = ""
                    self.selected_idx = 0
                    self.scroll_offset = 0
                    self.refresh_dirs()

        elif key in ("\r", "\n"):
            # Enter: confirma permanencia no diretorio atual (ou na pasta filtrada se o usuario buscou algo)
            if (
                self.search_query
                and self.filtered_dirs
                and 0 <= self.selected_idx < len(self.filtered_dirs)
            ):
                candidate = os.path.join(
                    self.current_path, self.filtered_dirs[self.selected_idx]
                )
                if os.path.isdir(candidate):
                    self.target_path = candidate
                else:
                    self.target_path = self.current_path
            else:
                self.target_path = self.current_path
            self.finished = True

        elif key == "\b":
            # Backspace: apaga exclusivamente caracteres do filtro de pesquisa (Bug Critico 2 resolvido)
            if self.search_query:
                self.search_query = self.search_query[:-1]
                self.selected_idx = 0
                self.scroll_offset = 0
                self.apply_filter()

        elif key == "HOME":
            self.selected_idx = 0
            self.scroll_offset = 0
            self.apply_filter()

        elif key == "END":
            if self.filtered_dirs:
                self.selected_idx = len(self.filtered_dirs) - 1
                self.apply_filter()

        elif key == "PAGEUP":
            self.selected_idx = max(0, self.selected_idx - self.max_lines)
            self.apply_filter()

        elif key == "PAGEDOWN":
            if self.filtered_dirs:
                self.selected_idx = min(
                    len(self.filtered_dirs) - 1, self.selected_idx + self.max_lines
                )
                self.apply_filter()

        elif key == "ESC":
            # Se houver filtro ativo, primeiro ESC limpa o filtro; segundo ESC cancela a operacao
            if self.search_query:
                self.search_query = ""
                self.selected_idx = 0
                self.scroll_offset = 0
                self.apply_filter()
            else:
                self.cancelled = True
                self.finished = True

        elif key == "\x03":
            self.cancelled = True
            self.finished = True

        elif len(key) == 1 and key.isprintable():
            # Qualquer tecla imprimivel (incluindo 'q', espaco, letras, numeros, simbolos) filtra a lista
            self.search_query += key
            self.selected_idx = 0
            self.scroll_offset = 0
            self.apply_filter()


def parse_args(argv):
    """Analisa os argumentos de linha de comando."""
    cwd_file = None
    start_path = None

    i = 1
    while i < len(argv):
        arg = argv[i]
        if arg == "--cwd-file" and i + 1 < len(argv):
            cwd_file = argv[i + 1]
            i += 2
        elif arg.startswith("--cwd-file="):
            cwd_file = arg.split("=", 1)[1]
            i += 1
        else:
            expanded = os.path.expanduser(arg)
            if os.path.isdir(expanded):
                start_path = os.path.abspath(expanded)
            i += 1

    return cwd_file, start_path


def write_output(target_path, cwd_file, stdout_stream=None):
    """
    Grava o caminho selecionado.
    Bug Critico 1 resolvido: se cwd_file foi fornecido, grava EXCLUSIVAMENTE nele
    sem vazar output duplicado em stdout.
    """
    if not target_path:
        return

    if cwd_file:
        with contextlib.suppress(OSError), open(cwd_file, "w", encoding="utf-8") as f:
            f.write(target_path)
    else:
        out = stdout_stream if stdout_stream is not None else sys.stdout
        out.write(target_path + "\n")
        out.flush()


def main():
    if not sys.stdin.isatty():
        sys.exit(1)

    cwd_file, start_path = parse_args(sys.argv)
    initial_path = start_path if start_path else os.getcwd()

    if not IS_WINDOWS:
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
    else:
        fd = None
        old_settings = None
        os.system("")  # habilita processamento ANSI no Windows Terminal / conhost

    ui_out = sys.stderr
    prev_line_count = 0

    def render_lines(lines):
        nonlocal prev_line_count
        if not lines:
            lines = ["\033[90m(nenhuma subpasta)\033[0m"]

        out = []
        if prev_line_count > 1:
            out.append(f"\033[{prev_line_count - 1}A\r")
        elif prev_line_count == 1:
            out.append("\r")

        for i, line in enumerate(lines):
            if i < len(lines) - 1:
                out.append(f"\033[2K{line}\r\n")
            else:
                out.append(f"\033[2K{line}")

        if prev_line_count > len(lines):
            diff = prev_line_count - len(lines)
            for _ in range(diff):
                out.append("\r\n\033[2K")
            out.append(f"\033[{diff}A\r")

        prev_line_count = len(lines)
        ui_out.write("".join(out))
        ui_out.flush()

    def clear_ui():
        nonlocal prev_line_count
        out = []
        if prev_line_count > 0:
            if prev_line_count > 1:
                out.append(f"\033[{prev_line_count - 1}A\r")
            else:
                out.append("\r")

            for i in range(prev_line_count):
                if i < prev_line_count - 1:
                    out.append("\033[2K\r\n")
                else:
                    out.append("\033[2K")

            if prev_line_count > 1:
                out.append(f"\033[{prev_line_count - 1}A\r")
            else:
                out.append("\r")
            prev_line_count = 0

        # Sempre garante que o cursor volte a ficar visivel (Bug Critico 4 resolvido)
        out.append("\033[?25h")
        ui_out.write("".join(out))
        ui_out.flush()

    state = NavigatorState(initial_path)

    def sigint_handler(signum, frame):
        state.cancelled = True
        state.finished = True
        clear_ui()
        if not IS_WINDOWS and old_settings is not None:
            with contextlib.suppress(OSError, Exception):
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        sys.exit(130)

    signal.signal(signal.SIGINT, sigint_handler)

    try:
        if not IS_WINDOWS:
            tty.setraw(fd)
            termios.tcflush(fd, termios.TCIFLUSH)
        ui_out.write("\033[?25l")  # Esconde cursor
        ui_out.flush()

        while not state.finished:
            term_size = shutil.get_terminal_size((80, 24))
            state.max_lines = max(3, min(8, term_size.lines - 4))

            lines, state.selected_idx, state.scroll_offset = build_ui_lines(
                state.current_path,
                state.filtered_dirs,
                state.selected_idx,
                state.scroll_offset,
                state.max_lines,
                term_size.columns,
                state.search_query,
            )
            render_lines(lines)

            key = read_key(fd)
            state.handle_key(key)

    except KeyboardInterrupt:
        state.cancelled = True
    finally:
        if not IS_WINDOWS and old_settings is not None:
            with contextlib.suppress(OSError, Exception):
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        clear_ui()

        if not state.cancelled and state.target_path:
            write_output(state.target_path, cwd_file)


if __name__ == "__main__":
    main()
