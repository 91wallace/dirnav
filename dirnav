#!/usr/bin/env python3
import os
import sys
import shutil

try:
    import termios
    import tty
    import select
    IS_WINDOWS = False
except ImportError:
    import msvcrt
    IS_WINDOWS = True

def get_directories(path):
    try:
        entries = os.listdir(path)
        dirs = [d for d in entries if os.path.isdir(os.path.join(path, d))]
        dirs = [d for d in dirs if not d.startswith('.')]
        return sorted(dirs, key=str.lower)
    except Exception:
        return []

def read_key(fd):
    if IS_WINDOWS:
        ch = msvcrt.getch()
        if ch in (b'\x00', b'\xe0'):
            ch2 = msvcrt.getch()
            if ch2 == b'H': return 'UP'
            elif ch2 == b'P': return 'DOWN'
            elif ch2 == b'M': return 'RIGHT'
            elif ch2 == b'K': return 'LEFT'
            elif ch2 == b'G': return 'HOME'
            elif ch2 == b'O': return 'END'
            elif ch2 == b'I': return 'PAGEUP'
            elif ch2 == b'Q': return 'PAGEDOWN'
            return ''
        if ch == b'\x1b':
            return 'ESC'
        if ch in (b'\r', b'\n'):
            return '\n'
        if ch in (b'\x08', b'\x7f'):
            return '\b'
        return ch.decode('utf-8', errors='replace')
    else:
        b = os.read(fd, 1)
        if not b:
            return ''
        if b == b'\x1b':
            # Verifica se há mais bytes chegando (setas ANSI, etc.) sem travar no ESC isolado
            # Timeout de 0.15s (150ms) garante tolerância para conexões remotas SSH e multiplexadores (tmux)
            r, _, _ = select.select([fd], [], [], 0.15)
            if r:
                b2 = os.read(fd, 1)
                seq = b + b2
                if b2 in (b'[', b'O'):
                    while True:
                        r2, _, _ = select.select([fd], [], [], 0.05)
                        if not r2:
                            break
                        bn = os.read(fd, 1)
                        seq += bn
                        if bn.isalpha() or bn == b'~':
                            break
                if seq in (b'\x1b[A', b'\x1bOA'): return 'UP'
                elif seq in (b'\x1b[B', b'\x1bOB'): return 'DOWN'
                elif seq in (b'\x1b[C', b'\x1bOC'): return 'RIGHT'
                elif seq in (b'\x1b[D', b'\x1bOD'): return 'LEFT'
                elif seq in (b'\x1b[H', b'\x1bOH', b'\x1b[1~', b'\x1b[7~'): return 'HOME'
                elif seq in (b'\x1b[F', b'\x1bOF', b'\x1b[4~', b'\x1b[8~'): return 'END'
                elif seq == b'\x1b[5~': return 'PAGEUP'
                elif seq == b'\x1b[6~': return 'PAGEDOWN'
                return ''
            return 'ESC'
        if b in (b'\r', b'\n'):
            return '\n'
        if b in (b'\x08', b'\x7f'):
            return '\b'
        return b.decode('utf-8', errors='replace')

def main():
    if not sys.stdin.isatty():
        sys.exit(1)

    # Argumentos
    cwd_file = None
    start_path = None

    i = 1
    while i < len(sys.argv):
        arg = sys.argv[i]
        if arg == '--cwd-file' and i + 1 < len(sys.argv):
            cwd_file = sys.argv[i + 1]
            i += 2
        elif arg.startswith('--cwd-file='):
            cwd_file = arg.split('=', 1)[1]
            i += 1
        else:
            expanded = os.path.expanduser(arg)
            if os.path.isdir(expanded):
                start_path = os.path.abspath(expanded)
            i += 1

    current_path = start_path if start_path else os.getcwd()

    selected_idx = 0
    scroll_offset = 0
    cancelled = False
    target_path = None

    # Configurações do terminal
    if not IS_WINDOWS:
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
    else:
        fd = None
        old_settings = None
        os.system('')  # habilita processamento ANSI no Windows Terminal / conhost

    # Usa stderr para a interface gráfica ANSI
    ui_out = sys.stderr
    prev_line_count = 0

    def render_lines(lines):
        nonlocal prev_line_count
        if not lines:
            lines = ["\033[90m(nenhuma subpasta)\033[0m"]

        out = []
        # Se já renderizamos antes, move o cursor exatamente para a primeira linha
        if prev_line_count > 1:
            out.append(f"\033[{prev_line_count - 1}A\r")
        elif prev_line_count == 1:
            out.append("\r")

        # Renderiza cada linha; a última linha NÃO tem \r\n para evitar scroll no rodapé do terminal
        for i, line in enumerate(lines):
            if i < len(lines) - 1:
                out.append(f"\033[2K{line}\r\n")
            else:
                out.append(f"\033[2K{line}")

        # Se a lista anterior tinha mais linhas, limpa as linhas excedentes abaixo
        if prev_line_count > len(lines):
            diff = prev_line_count - len(lines)
            for _ in range(diff):
                out.append("\r\n\033[2K")
            out.append(f"\033[{diff}A\r")

        prev_line_count = len(lines)
        ui_out.write("".join(out))
        ui_out.flush()

    def clear_ui():
        nonlocal prev_line_count
        if prev_line_count > 0:
            out = []
            if prev_line_count > 1:
                out.append(f"\033[{prev_line_count - 1}A\r")
            else:
                out.append("\r")

            for i in range(prev_line_count):
                if i < prev_line_count - 1:
                    out.append("\033[2K\r\n")
                else:
                    out.append("\033[2K")

            if prev_line_count > 1:
                out.append(f"\033[{prev_line_count - 1}A\r")
            else:
                out.append("\r")

            out.append("\033[?25h")
            ui_out.write("".join(out))
            ui_out.flush()
            prev_line_count = 0

    try:
        if not IS_WINDOWS:
            tty.setraw(fd)
            termios.tcflush(fd, termios.TCIFLUSH)
        ui_out.write("\033[?25l")  # Esconde cursor
        ui_out.flush()

        while True:
            items = get_directories(current_path)  # Apenas os diretórios

            term_size = shutil.get_terminal_size((80, 24))
            # Garante que seja compacto e inline logo abaixo da linha do prompt (máximo 8 subpastas para não ocupar a tela)
            max_lines = max(3, min(8, term_size.lines - 4))

            if len(items) == 0:
                selected_idx = 0
                scroll_offset = 0
            else:
                if selected_idx >= len(items):
                    selected_idx = len(items) - 1
                if selected_idx < 0:
                    selected_idx = 0
                if selected_idx < scroll_offset:
                    scroll_offset = selected_idx
                elif selected_idx >= scroll_offset + max_lines:
                    scroll_offset = selected_idx - max_lines + 1

            # Calcula quantas linhas de diretório cabem reservando espaço para indicadores ↑ / ↓
            has_above = (scroll_offset > 0)
            available_for_items = max_lines - (1 if has_above else 0)
            has_below = (len(items) > scroll_offset + available_for_items)
            if has_below:
                available_for_items -= 1
            available_for_items = max(1, available_for_items)

            # Reajusta se selected_idx ultrapassar a nova janela visível
            if selected_idx >= scroll_offset + available_for_items:
                scroll_offset = selected_idx - available_for_items + 1
                has_above = (scroll_offset > 0)
                available_for_items = max_lines - (1 if has_above else 0)
                has_below = (len(items) > scroll_offset + available_for_items)
                if has_below:
                    available_for_items -= 1
                available_for_items = max(1, available_for_items)

            # Monta linhas
            lines = []
            max_name_len = max(10, term_size.columns - 8)

            # Primeira linha: diretório atual exibido à esquerda (raiz)
            curr_disp = current_path if len(current_path) <= max_name_len else "..." + current_path[-(max_name_len - 3):]
            lines.append(f"\033[1;36m📁 {curr_disp}\033[0m")

            if not items:
                lines.append("     \033[90m(nenhuma subpasta)\033[0m")
            else:
                if has_above:
                    count_above = scroll_offset
                    lines.append(f"     \033[90m↑ +{count_above} acima...\033[0m")

                visible_items = items[scroll_offset:scroll_offset + available_for_items]
                for i, d in enumerate(visible_items):
                    actual_idx = scroll_offset + i
                    is_selected = (actual_idx == selected_idx)
                    sub_name_len = max(10, term_size.columns - 10)
                    disp_name = d if len(d) <= sub_name_len else d[:sub_name_len - 3] + "..."

                    if is_selected:
                        lines.append(f"  \033[7m > {disp_name}/ \033[0m")
                    else:
                        lines.append(f"     \033[1;34m{disp_name}/\033[0m")

                if has_below:
                    count_below = len(items) - (scroll_offset + len(visible_items))
                    lines.append(f"     \033[90m↓ +{count_below} mais...\033[0m")

            render_lines(lines)

            # Lê tecla
            key = read_key(fd)

            if key in ('UP', 'k', 'K'):
                if selected_idx > 0:
                    selected_idx -= 1
            elif key in ('DOWN', 'j', 'J'):
                if selected_idx < len(items) - 1:
                    selected_idx += 1
            elif key in ('LEFT', 'h', 'H', '\x7f', '\b'):
                # Seta para trás: volta um nível
                parent = os.path.dirname(current_path)
                if parent and parent != current_path:
                    current_path = parent
                    selected_idx = 0
                    scroll_offset = 0
            elif key in ('RIGHT', 'l', 'L'):
                # Seta para a direita ou l: entra no diretório selecionado
                if items and 0 <= selected_idx < len(items):
                    new_path = os.path.join(current_path, items[selected_idx])
                    if os.path.isdir(new_path):
                        current_path = new_path
                        selected_idx = 0
                        scroll_offset = 0
            elif key in ('\r', '\n'):
                # Enter: entra no diretório selecionado; se pasta não tiver subpastas, confirma e encerra
                if items and 0 <= selected_idx < len(items):
                    new_path = os.path.join(current_path, items[selected_idx])
                    if os.path.isdir(new_path):
                        current_path = new_path
                        selected_idx = 0
                        scroll_offset = 0
                else:
                    target_path = current_path
                    break
            elif key == ' ':
                # Espaço: confirma a pasta selecionada (se houver) ou a atual
                if items and 0 <= selected_idx < len(items):
                    target_path = os.path.join(current_path, items[selected_idx])
                else:
                    target_path = current_path
                break
            elif key in ('q', 'Q'):
                # 'q': fica no diretório atual
                target_path = current_path
                break
            elif key in ('HOME',):
                selected_idx = 0
                scroll_offset = 0
            elif key in ('END',):
                if items:
                    selected_idx = len(items) - 1
            elif key in ('PAGEUP',):
                selected_idx = max(0, selected_idx - max_lines)
            elif key in ('PAGEDOWN',):
                if items:
                    selected_idx = min(len(items) - 1, selected_idx + max_lines)
            elif key in ('ESC', '\x03'):
                cancelled = True
                break

    finally:
        if not IS_WINDOWS and old_settings is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        clear_ui()

        if not cancelled and target_path:
            # 1. Se foi passado arquivo de saída (--cwd-file), grava nele
            if cwd_file:
                try:
                    with open(cwd_file, 'w', encoding='utf-8') as f:
                        f.write(target_path)
                except Exception:
                    pass

            # 2. Se stdout foi redirecionado (canal/subshell) ou executado sem wrapper, imprime no stdout
            if not sys.stdout.isatty() or not cwd_file:
                print(target_path)

if __name__ == '__main__':
    main()
