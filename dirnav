def normalize_text(text):
    """Remove acentos e normaliza para minusculas para comparacao flexivel."""
    if not text:
        return ""
    nfkd = unicodedata.normalize("NFKD", text)
    return "".join(c for c in nfkd if not unicodedata.combining(c)).lower()


def sanitize_terminal_text(text):
    """Render control characters visibly so filesystem text cannot emit ANSI."""
    return "".join(char if char.isprintable() else "�" for char in text)


def terminal_cell_width(text):
    width = 0
    for char in text:
        if unicodedata.combining(char):
            continue
        width += 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1
    return width


def truncate_text(text, max_cells, from_end=False):
    if max_cells <= 0:
        return ""
    if terminal_cell_width(text) <= max_cells:
        return text
    if max_cells <= 3:
        return "." * max_cells
    ellipsis = "..."
    budget = max_cells - len(ellipsis)
    selected = []
    used = 0
    for char in reversed(text) if from_end else text:
        char_width = 0 if unicodedata.combining(char) else (
            2 if unicodedata.east_asian_width(char) in ("W", "F") else 1
        )
        if used + char_width > budget:
            break
        selected.append(char)
        used += char_width
    if from_end:
        selected.reverse()
        return ellipsis + "".join(selected)
    return "".join(selected) + ellipsis


def get_directories(path):
    """Retorna lista ordenada de subpastas visiveis (nao ocultas por '.')."""
    try:
        with os.scandir(path) as entries:
            dirs = [
                entry.name
                for entry in entries
                if not entry.name.startswith(".") and entry.is_dir(follow_symlinks=True)
            ]
        return sorted(dirs, key=str.lower)
    except OSError:
        return []


def _is_hidden_entry(entry):
    if entry.name.startswith("."):
        return True
    if os.name != "nt":
        return False
    try:
        attributes = getattr(entry.stat(follow_symlinks=False), "st_file_attributes", 0)
        return bool(attributes & 0x6)  # FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM
    except OSError:
        return True


def get_entries(path, show_files=False, show_hidden_files=False):
    """List directories by default; optionally include regular and hidden/system files."""
    try:
        with os.scandir(path) as entries:
            directories = []
            files = []
            for entry in entries:
                hidden = _is_hidden_entry(entry)
                if entry.is_dir(follow_symlinks=True):
                    if not hidden:
                        directories.append(entry.name)
                elif (
                    entry.is_file(follow_symlinks=False) or entry.is_symlink()
                ) and show_files and (show_hidden_files or not hidden):
                    files.append(entry.name)
        return sorted(directories, key=str.lower) + sorted(files, key=str.lower)
    except OSError:
        return []


def filter_directories(dirs, search_query):
    """Filtra a lista de diretorios com base na query (case-insensitive e accent-insensitive)."""
    if not search_query:
        return list(dirs)
    q_lower = search_query.lower()
    q_norm = normalize_text(search_query)
    result = []
    for d in dirs:
        if q_lower in d.lower() or q_norm in normalize_text(d):
            result.append(d)
    return result


def compute_viewport(total_items, selected_idx, scroll_offset, max_lines):
    """
    Calcula de forma deterministica a janela de exibicao (viewport) garantindo
    a invariante: selected_idx SEMPRE pertence a [scroll_offset, scroll_offset + available - 1].
    Retorna: (selected_idx, scroll_offset, available_for_items, has_above, has_below)
    """
    max_lines = max(3, max_lines)
    if total_items <= 0:
        return 0, 0, max_lines, False, False

    selected_idx = max(0, min(selected_idx, total_items - 1))
    scroll_offset = max(0, min(scroll_offset, total_items - 1))

    # Se todos os itens cabem em max_lines sem precisar de scroll
    if total_items <= max_lines:
        return selected_idx, 0, total_items, False, False

    # Garante que scroll_offset nunca fique depois de selected_idx
    scroll_offset = min(scroll_offset, selected_idx)

    # Iteramos para convergir scroll_offset considerando as linhas ocupadas pelos indicadores ↑ e ↓
    for _ in range(4):
        has_above = scroll_offset > 0
        # Se mostrarmos a partir de scroll_offset, quantas linhas sobram se não tiver has_below?
        temp_avail = max_lines - (1 if has_above else 0)
        has_below = (scroll_offset + temp_avail) < total_items
        available_for_items = max(
            1, max_lines - (1 if has_above else 0) - (1 if has_below else 0)
        )

        if selected_idx >= scroll_offset + available_for_items:
            scroll_offset = selected_idx - available_for_items + 1
        elif selected_idx < scroll_offset:
            scroll_offset = selected_idx

        # Se chegamos perto do fim da lista e sobrou espaço vazio, puxa scroll_offset para trás
        has_above = scroll_offset > 0
        has_below = (scroll_offset + available_for_items) < total_items
        available_for_items = max(
            1, max_lines - (1 if has_above else 0) - (1 if has_below else 0)
        )
        if scroll_offset + available_for_items > total_items:
            scroll_offset = max(0, total_items - available_for_items)

    # Recalculo final estrito após estabilização de scroll_offset
    has_above = scroll_offset > 0
    temp_avail = max_lines - (1 if has_above else 0)
    has_below = (scroll_offset + temp_avail) < total_items
    available_for_items = max(
        1, max_lines - (1 if has_above else 0) - (1 if has_below else 0)
    )

    return selected_idx, scroll_offset, available_for_items, has_above, has_below


def build_ui_lines(
    current_path,
    items,
    selected_idx,
    scroll_offset,
    max_lines,
    term_columns,
    search_query="",
    footer_text=None,
    heading=None,
    status_message="",
):
    """Constroi a lista de linhas formatadas com ANSI para renderizacao."""
    (
        selected_idx,
        scroll_offset,
        available_for_items,
        has_above,
        has_below,
    ) = compute_viewport(len(items), selected_idx, scroll_offset, max_lines)

    lines = []
    max_name_len = max(1, term_columns - (8 if term_columns >= 12 else 1))

    # Primeira linha: diretorio atual exibido a esquerda (raiz)
    safe_path = sanitize_terminal_text(current_path)
    curr_disp = truncate_text(safe_path, max_name_len, from_end=True)
    path_label = f"📁 {curr_disp}" if term_columns >= 4 else curr_disp
    lines.append(f"\033[1;36m{truncate_text(path_label, term_columns)}\033[0m")
    if heading:
        lines.append(f"\033[1;33m{truncate_text(sanitize_terminal_text(heading), term_columns)}\033[0m")

    # Segunda linha (se houver filtro ativo): barra de pesquisa
    if search_query:
        filter_label = f"Filtro: {sanitize_terminal_text(search_query)}_"
        lines.append(f"   \033[1;33m{truncate_text(filter_label, max(1, term_columns - 3))}\033[0m")

    if not items:
        if search_query:
            empty_result = f"(nenhum resultado para '{sanitize_terminal_text(search_query)}')"
            lines.append(
                f"     \033[90m{truncate_text(empty_result, max(1, term_columns - 5))}\033[0m"
            )
        else:
            lines.append(f"     \033[90m{truncate_text('(nenhuma subpasta)', max(1, term_columns - 5))}\033[0m")
    else:
        if has_above:
            count_above = scroll_offset
            lines.append(f"     \033[90m{truncate_text(f'↑ +{count_above} acima...', max(1, term_columns - 5))}\033[0m")

        visible_items = items[scroll_offset : scroll_offset + available_for_items]
        for i, d in enumerate(visible_items):
            actual_idx = scroll_offset + i
            is_selected = actual_idx == selected_idx
            safe_name = sanitize_terminal_text(d)
            suffix = "/" if os.path.isdir(os.path.join(current_path, d)) else ""
            prefix = ("  > " if term_columns >= 10 else ">") if is_selected else (
                "     " if term_columns >= 10 else ""
            )
            sub_name_len = max(
                0,
                term_columns - terminal_cell_width(prefix) - terminal_cell_width(suffix),
            )
            disp_name = truncate_text(safe_name, sub_name_len)

            if is_selected:
                lines.append(f"\033[7m{prefix}{disp_name}{suffix}\033[0m")
            else:
                lines.append(f"\033[1;34m{prefix}{disp_name}{suffix}\033[0m")

        if has_below:
            count_below = len(items) - (scroll_offset + len(visible_items))
            lines.append(f"     \033[90m{truncate_text(f'↓ +{count_below} mais...', max(1, term_columns - 5))}\033[0m")

    if footer_text is not None:
        if status_message:
            lines.append(f"\033[33m{truncate_text(sanitize_terminal_text(status_message), term_columns)}\033[0m")
        lines.append(f"\033[7m{fit_footer(footer_text, term_columns)}\033[0m")
    return lines, selected_idx, scroll_offset


def fit_footer(text, term_columns, context="navigation", compact_options=None):
    """Fit a plain-text footer into a narrow terminal without splitting ANSI codes."""
    width = max(1, term_columns)
    if terminal_cell_width(text) <= width:
        return text
    compact_options = compact_options or {
        "navigation": ("F5:Cop F6:Mov F7:Arquivos F8:Ocultos Del:Apagar", "Del:Apagar"),
        "destination": ("F7:Arquivos F8:Ocultos Enter:Sel Esc:Vol", "Enter:Sel Esc:Vol"),
        "confirmation": ("Enter:Confirmar Esc:Cancelar", "Enter:Sim Esc:Não", "Esc:Cancelar"),
        "conflict": ("S:Substituir R:Renomear Esc:Cancelar", "S:Subst R:Nome Esc:Cancelar", "R:Nome Esc:Cancelar"),
        "help": ("Esc:Voltar",),
    }.get(context, ("↑/↓:Navegar Enter:Abrir Esc:Cancelar", "Esc:Cancelar"))
    for option in compact_options:
        if terminal_cell_width(option) <= width:
            return option
    return truncate_text(compact_options[-1], width)


def build_footer(
    term_columns,
    context="navigation",
    show_files=False,
    show_hidden_files=False,
):
    files_toggle = "Somente diretorios" if show_files else "Exibir arquivos"
    hidden_toggle = "Ocultar arquivos do sistema" if show_hidden_files else "Arquivos Ocultos"
    compact_files_toggle = "Som dirs" if show_files else "Exibir arq"
    compact_hidden_toggle = "Ocultar sist" if show_hidden_files else "Arq ocultos"
    if context == "destination":
        text = (
            f"↑/↓: Navegar | F7:{files_toggle} | F8:{hidden_toggle} | "
            "→: Abrir | Enter: Selecionar destino | Esc: Voltar"
        )
        compact_options = (
            f"F7:{files_toggle} F8:{hidden_toggle} Enter:Sel Esc:Voltar",
            f"F7:{files_toggle} F8:{hidden_toggle}",
            "Enter:Sel Esc:Vol",
            "Esc:Voltar",
        )
    elif context == "confirmation":
        text = "Enter: Confirmar | Esc: Cancelar"
        compact_options = None
    elif context == "conflict":
        text = "S: Substituir | R: Renomear | Esc: Cancelar"
        compact_options = None
    elif context == "help":
        text = "Esc/F1: Voltar"
        compact_options = None
    else:
        text = (
            "↑/↓: Navegar | Enter: Selecionar | F5: Copiar | F6: Mover | "
            f"F7:{files_toggle} | F8:{hidden_toggle} | Del:Apagar | Esc: Voltar"
        )
        compact_options = (
            f"Enter:Sel F5:Cop F6:Mov F7:{files_toggle} F8:{hidden_toggle} Del:Apagar Esc:Voltar",
            f"F5:Cop F6:Mov F7:{files_toggle} F8:{hidden_toggle} Del:Apagar Esc:Voltar",
            f"Enter:Sel F7:{files_toggle} F8:{hidden_toggle} Del:Apagar Esc:Voltar",
            f"F7:{files_toggle} F8:{hidden_toggle} Del:Apagar",
            f"F7:{compact_files_toggle} F8:{compact_hidden_toggle} Del:Apagar",
            f"F7:{files_toggle} F8:{hidden_toggle}",
            f"F7:{compact_files_toggle} F8:{compact_hidden_toggle}",
            "Enter:Sel Esc:Vol",
            "Del:Apagar",
        )
    return fit_footer(text, term_columns, context, compact_options)


