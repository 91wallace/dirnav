def _windows_current_user_sid(advapi, kernel, TokenUser):
    from ctypes import wintypes

    token = wintypes.HANDLE()
    if not advapi.OpenProcessToken(kernel.GetCurrentProcess(), 0x0008, ctypes.byref(token)):
        raise ctypes.WinError(ctypes.get_last_error())
    try:
        required = wintypes.DWORD()
        advapi.GetTokenInformation(token, 1, None, 0, ctypes.byref(required))
        buffer = ctypes.create_string_buffer(required.value)
        if not advapi.GetTokenInformation(token, 1, buffer, required, ctypes.byref(required)):
            raise ctypes.WinError(ctypes.get_last_error())
        sid_ptr = ctypes.cast(buffer, ctypes.POINTER(TokenUser)).contents.User.Sid
        sid_text = wintypes.LPWSTR()
        if not advapi.ConvertSidToStringSidW(sid_ptr, ctypes.byref(sid_text)):
            raise ctypes.WinError(ctypes.get_last_error())
        try:
            return sid_text.value
        finally:
            kernel.LocalFree(sid_text)
    finally:
        kernel.CloseHandle(token)


def _windows_security_descriptor(advapi, SecurityAttributes, sddl):
    from ctypes import wintypes

    descriptor = wintypes.LPVOID()
    size = wintypes.DWORD()
    if not advapi.ConvertStringSecurityDescriptorToSecurityDescriptorW(
        sddl, 1, ctypes.byref(descriptor), ctypes.byref(size)
    ):
        raise ctypes.WinError(ctypes.get_last_error())
    attributes = SecurityAttributes(
        ctypes.sizeof(SecurityAttributes), descriptor, False
    )
    return descriptor, attributes


def _windows_security_snapshot(advapi, kernel, path, AclSizeInformation, AceHeader):
    from ctypes import wintypes

    owner = wintypes.LPVOID()
    dacl = wintypes.LPVOID()
    descriptor = wintypes.LPVOID()
    status = advapi.GetNamedSecurityInfoW(
        path,
        1,  # SE_FILE_OBJECT
        0x00000001 | 0x00000004,  # OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION
        ctypes.byref(owner),
        None,
        ctypes.byref(dacl),
        None,
        ctypes.byref(descriptor),
    )
    if status:
        raise ctypes.WinError(status)
    try:
        if not dacl.value:
            raise OSError("object has a NULL DACL")
        control = wintypes.WORD()
        revision = wintypes.DWORD()
        if not advapi.GetSecurityDescriptorControl(
            descriptor, ctypes.byref(control), ctypes.byref(revision)
        ):
            raise ctypes.WinError(ctypes.get_last_error())
        info = AclSizeInformation()
        if not advapi.GetAclInformation(
            dacl, ctypes.byref(info), ctypes.sizeof(info), 2
        ):
            raise ctypes.WinError(ctypes.get_last_error())

        def sid_string(sid_ptr):
            sid_text = wintypes.LPWSTR()
            if not advapi.ConvertSidToStringSidW(sid_ptr, ctypes.byref(sid_text)):
                raise ctypes.WinError(ctypes.get_last_error())
            try:
                return sid_text.value
            finally:
                kernel.LocalFree(sid_text)

        owner_sid = sid_string(owner)
        aces = []
        for index in range(info.AceCount):
            ace_ptr = wintypes.LPVOID()
            if not advapi.GetAce(dacl, index, ctypes.byref(ace_ptr)):
                raise ctypes.WinError(ctypes.get_last_error())
            header = ctypes.cast(ace_ptr, ctypes.POINTER(AceHeader)).contents
            if header.AceType != 0:  # only ACCESS_ALLOWED_ACE is accepted
                raise OSError("unexpected or deny ACE in secure artifact DACL")
            mask = wintypes.DWORD.from_address(ace_ptr.value + 4).value
            # ACCESS_ALLOWED_ACE stores the SID inline after its mask, not a pointer.
            sid_ptr = ace_ptr.value + 8
            aces.append((sid_string(sid_ptr), mask, header.AceFlags))
        return owner_sid, bool(control.value & 0x1000), aces
    finally:
        kernel.LocalFree(descriptor)


def _windows_verify_artifact(advapi, kernel, path, owner_sid, expected_aces, is_directory):
    _, _, _, _, AceHeader, AclSizeInformation = _win32_security_api()
    actual_owner, protected, actual_aces = _windows_security_snapshot(
        advapi, kernel, path, AclSizeInformation, AceHeader
    )
    if actual_owner != owner_sid:
        raise OSError("secure artifact owner does not match current user")
    if not protected:
        raise OSError("secure artifact DACL is not protected")
    if sorted(actual_aces) != sorted(expected_aces):
        raise OSError("secure artifact DACL differs from the explicit allowlist")
    attributes = kernel.GetFileAttributesW(path)
    if attributes == 0xFFFFFFFF:
        raise ctypes.WinError(ctypes.get_last_error())
    if attributes & 0x400:  # FILE_ATTRIBUTE_REPARSE_POINT
        raise OSError("secure artifact unexpectedly became a reparse point")
    if is_directory and not attributes & 0x10:  # FILE_ATTRIBUTE_DIRECTORY
        raise OSError("secure artifact is not a directory")
    return actual_aces


def create_secure_cmd_temp_directory():
    """Atomically create and verify the private CMD artifact directory."""
    if os.name != "nt":
        raise OSError("secure CMD artifact directories require Windows")
    root = os.path.abspath(os.environ.get("USERPROFILE", ""))
    if not root or not os.path.isdir(root):
        raise OSError("USERPROFILE is missing or unavailable")
    advapi, kernel, SecurityAttributes, TokenUser, AceHeader, AclSizeInformation = _win32_security_api()
    user_sid = _windows_current_user_sid(advapi, kernel, TokenUser)
    system_sid = "S-1-5-18"
    admin_sid = "S-1-5-32-544"
    allowed_sids = {user_sid, system_sid, admin_sid}
    parent_owner, parent_protected, parent_aces = _windows_security_snapshot(
        advapi, kernel, root, AclSizeInformation, AceHeader
    )
    parent_attributes = kernel.GetFileAttributesW(root)
    if parent_attributes == 0xFFFFFFFF or parent_attributes & 0x400:
        raise OSError("USERPROFILE parent is unavailable or a reparse point")
    if not parent_protected:
        raise OSError("USERPROFILE parent DACL is not protected")
    if parent_owner not in allowed_sids:
        raise OSError("USERPROFILE owner is outside the trusted SID set")
    unsafe_parent_mask = 0x00000002 | 0x00000004 | 0x00000010 | 0x00000040 | 0x00000100 | 0x00010000 | 0x00040000 | 0x00080000 | 0x10000000 | 0x40000000
    if any(sid not in allowed_sids and mask & unsafe_parent_mask for sid, mask, _ in parent_aces):
        raise OSError("USERPROFILE parent grants write/delete rights to an untrusted SID")

    dir_sddl = f"O:{user_sid}G:SYD:P(A;OICI;FA;;;{user_sid})(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)"
    expected_dir_aces = [
        (user_sid, 0x001F01FF, 0x03),
        (system_sid, 0x001F01FF, 0x03),
        (admin_sid, 0x001F01FF, 0x03),
    ]
    descriptor, attributes = _windows_security_descriptor(advapi, SecurityAttributes, dir_sddl)
    try:
        for _ in range(20):
            token = secrets.token_hex(16)
            path = os.path.join(root, "dirnav-cmd-" + token)
            if kernel.CreateDirectoryW(path, ctypes.byref(attributes)):
                try:
                    _windows_verify_artifact(
                        advapi, kernel, path, user_sid, expected_dir_aces, True
                    )
                    return token
                except OSError:
                    kernel.RemoveDirectoryW(path)
                    raise
            error = ctypes.get_last_error()
            if error not in (80, 183):  # ERROR_FILE_EXISTS / ERROR_ALREADY_EXISTS
                raise ctypes.WinError(error)
        raise FileExistsError("unable to allocate a unique secure CMD directory")
    finally:
        kernel.LocalFree(descriptor)


def _write_secure_cmd_batch(cwd_file, script):
    advapi, kernel, SecurityAttributes, TokenUser, _, _ = _win32_security_api()
    user_sid = _windows_current_user_sid(advapi, kernel, TokenUser)
    path = os.path.abspath(cwd_file)
    root = os.path.abspath(os.environ.get("USERPROFILE", ""))
    parent = os.path.dirname(path)
    base = os.path.basename(parent)
    try:
        common = os.path.commonpath([root, parent])
    except ValueError as exc:
        raise OSError("CMD artifact path is outside the secure per-user directory") from exc
    if common.casefold() != root.casefold() or not re.fullmatch(r"dirnav-cmd-[0-9a-f]{32}", base):
        raise OSError("CMD artifact path is outside the secure per-user directory")
    expected_dir_aces = [
        (user_sid, 0x001F01FF, 0x03),
        ("S-1-5-18", 0x001F01FF, 0x03),
        ("S-1-5-32-544", 0x001F01FF, 0x03),
    ]
    _windows_verify_artifact(advapi, kernel, parent, user_sid, expected_dir_aces, True)
    file_sddl = f"O:{user_sid}G:SYD:P(A;;FA;;;{user_sid})(A;;FA;;;SY)(A;;FA;;;BA)"
    expected_file_aces = [
        (user_sid, 0x001F01FF, 0),
        ("S-1-5-18", 0x001F01FF, 0),
        ("S-1-5-32-544", 0x001F01FF, 0),
    ]
    descriptor, attributes = _windows_security_descriptor(advapi, SecurityAttributes, file_sddl)
    from ctypes import wintypes

    handle = wintypes.HANDLE(-1).value
    created = False
    try:
        handle = kernel.CreateFileW(path, 0x40000000, 0, ctypes.byref(attributes), 1, 0x100, None)
        if handle == wintypes.HANDLE(-1).value:
            raise ctypes.WinError(ctypes.get_last_error())
        created = True
        payload = script.encode("utf-8")
        offset = 0
        while offset < len(payload):
            written = wintypes.DWORD()
            block = payload[offset:]
            buffer = ctypes.create_string_buffer(block)
            if not kernel.WriteFile(handle, buffer, len(block), ctypes.byref(written), None):
                raise ctypes.WinError(ctypes.get_last_error())
            if written.value == 0:
                raise OSError("WriteFile returned zero bytes")
            offset += written.value
        if not kernel.FlushFileBuffers(handle):
            raise ctypes.WinError(ctypes.get_last_error())
        kernel.CloseHandle(handle)
        handle = wintypes.HANDLE(-1).value
        _windows_verify_artifact(advapi, kernel, path, user_sid, expected_file_aces, False)
    except Exception:
        if handle != wintypes.HANDLE(-1).value:
            kernel.CloseHandle(handle)
        if created:
            kernel.DeleteFileW(path)
        raise
    finally:
        kernel.LocalFree(descriptor)


def build_cmd_directory_script(path, codepage):
    """Build a quoted batch command that changes directory in the caller's CMD."""
    if any(char in path for char in ('"', "\r", "\n")):
        raise ValueError("invalid character for a Windows directory path")
    try:
        original_codepage = int(codepage)
    except (TypeError, ValueError):
        original_codepage = 437

    # Batch expansion remains active inside quotes. Generate separate literal
    # commands for /V:OFF and /V:ON so carets and exclamation marks survive both
    # parsers. The temporary probe variable is unpredictable and removed before
    # returning to the caller's environment.
    plain_path = path.replace("%", "%%")
    delayed_chars = []
    index = 0
    has_bang = "!" in path
    while index < len(path):
        if path[index : index + 2] == "^!":
            delayed_chars.append("^^^!")
            index += 2
        elif path[index] == "^":
            delayed_chars.append("^^" if has_bang else "^")
            index += 1
        elif path[index] == "!":
            delayed_chars.append("^!")
            index += 1
        else:
            delayed_chars.append("%%" if path[index] == "%" else path[index])
            index += 1
    delayed_path = "".join(delayed_chars)
    probe = "DIRNAV_DELAYED_" + secrets.token_hex(8).upper()
    return "\r\n".join(
        (
            "@echo off",
            "chcp 65001 >nul",
            f'set "{probe}=1"',
            f'if "!{probe}!"=="1" goto dirnav_delayed',
            f'set "{probe}="',
            "setlocal DisableDelayedExpansion",
            f'endlocal & cd /d "{plain_path}"',
            "goto dirnav_cd_result",
            ":dirnav_delayed",
            f'set "{probe}="',
            "setlocal DisableDelayedExpansion",
            f'endlocal & cd /d "{delayed_path}"',
            ":dirnav_cd_result",
            "if errorlevel 1 goto dirnav_cmd_failed",
            f"chcp {original_codepage} >nul",
            "exit /b 0",
            ":dirnav_cmd_failed",
            f"chcp {original_codepage} >nul",
            "exit /b 1",
            "",
        )
    )


def write_output(target_path, cwd_file, stdout_stream=None, cmd_escape=False):
    """
    Grava o caminho selecionado.
    Bug Critico 1 e 7 resolvidos: normaliza o caminho com abspath/normpath e,
    se cwd_file foi fornecido, grava EXCLUSIVAMENTE nele em UTF-8 sem BOM.
    """
    if not target_path:
        return True

    norm_target = os.path.normpath(os.path.abspath(target_path))

    if cwd_file:
        try:
            if cmd_escape:
                script = build_cmd_directory_script(
                    norm_target, os.environ.get("DIRNAV_CMD_CODEPAGE", "437")
                )
                _write_secure_cmd_batch(cwd_file, script)
            else:
                with open(cwd_file, "w", encoding="utf-8", newline="") as f:
                    f.write(norm_target)
        except OSError as exc:
            print(f"dirnav: nao foi possivel gravar o caminho selecionado: {exc}", file=sys.stderr)
            return False
    else:
        out = stdout_stream if stdout_stream is not None else sys.stdout
        out.write(norm_target + "\n")
        out.flush()
    return True


def main():
    if sys.argv[1:] == ["--cmd-create-temp"]:
        try:
            print(create_secure_cmd_temp_directory())
        except OSError as exc:
            print(f"dirnav: nao foi possivel criar diretorio CMD seguro: {exc}", file=sys.stderr)
            sys.exit(1)
        sys.exit(0)

    parsed = parse_args(sys.argv)
    if len(parsed) == 3:
        cwd_file, start_path, action = parsed
    else:
        cwd_file, start_path = parsed
        action = None

    if action == "version":
        print(f"dirnav {__version__}")
        sys.exit(0)
    elif action == "help":
        print(
            f"dirnav {__version__} - Navegador de diretorios inline\n"
            "Uso: dn [caminho] | cc [caminho] | dirnav [--setup|--uninstall|--version]"
        )
        sys.exit(0)
    elif action == "setup":
        updated = setup_shell_integration()
        for p in updated:
            print(f"[OK] Integracao configurada em: {p}")
        sys.exit(0)
    elif action == "uninstall":
        cleaned = uninstall_shell_integration()
        for p in cleaned:
            print(f"[OK] Integracao removida de: {p}")
        sys.exit(0)

    test_keys_env = os.environ.get("DIRNAV_TEST_KEYS")
    if not sys.stdin.isatty() and not test_keys_env:
        sys.exit(1)

    initial_path = start_path if start_path else os.getcwd()

    if test_keys_env:
        fd = None
        old_settings = None
        test_key_queue = [
            "\n" if k == "ENTER" else "\b" if k == "BACKSPACE" else k
            for k in test_keys_env.split(",")
            if k
        ]
    elif not IS_WINDOWS:
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        test_key_queue = None
    else:
        fd = None
        old_settings = None
        test_key_queue = None
        os.system("")  # habilita processamento ANSI no Windows Terminal / conhost

    ui_out = sys.stderr
    prev_line_count = 0

    def render_lines(lines):
        nonlocal prev_line_count
        if not lines:
            lines = ["\033[90m(nenhuma subpasta)\033[0m"]

        out = []
        if prev_line_count > 1:
            out.append(f"\033[{prev_line_count - 1}A\r")
        elif prev_line_count == 1:
            out.append("\r")

        for i, line in enumerate(lines):
            if i < len(lines) - 1:
                out.append(f"\033[2K{line}\r\n")
            else:
                out.append(f"\033[2K{line}")

        if prev_line_count > len(lines):
            diff = prev_line_count - len(lines)
            for _ in range(diff):
                out.append("\r\n\033[2K")
            out.append(f"\033[{diff}A\r")

        prev_line_count = len(lines)
        ui_out.write("".join(out))
        ui_out.flush()

    def clear_ui():
        nonlocal prev_line_count
        out = []
        if prev_line_count > 0:
            if prev_line_count > 1:
                out.append(f"\033[{prev_line_count - 1}A\r")
            else:
                out.append("\r")

            for i in range(prev_line_count):
                if i < prev_line_count - 1:
                    out.append("\033[2K\r\n")
                else:
                    out.append("\033[2K")

            if prev_line_count > 1:
                out.append(f"\033[{prev_line_count - 1}A\r")
            else:
                out.append("\r")
            prev_line_count = 0

        # Sempre garante que o cursor volte a ficar visivel (Bug Critico 4 resolvido)
        out.append("\033[?25h")
        ui_out.write("".join(out))
        ui_out.flush()

    state = NavigatorState(initial_path)

    def sigint_handler(signum, frame):
        state.cancelled = True
        state.finished = True
        clear_ui()
        if not IS_WINDOWS and old_settings is not None:
            with contextlib.suppress(OSError, Exception):
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        sys.exit(130)

    signal.signal(signal.SIGINT, sigint_handler)

    try:
        if not IS_WINDOWS and fd is not None:
            tty.setraw(fd)
            termios.tcflush(fd, termios.TCIFLUSH)
        ui_out.write("\033[?25l")  # Esconde cursor
        ui_out.flush()

        while not state.finished:
            term_size = shutil.get_terminal_size((80, 24))
            state.max_lines = max(3, min(8, term_size.lines - 4))

            lines, state.selected_idx, state.scroll_offset = build_ui_lines(
                state.current_path,
                state.filtered_dirs,
                state.selected_idx,
                state.scroll_offset,
                state.max_lines,
                term_size.columns,
                state.search_query,
            )
            render_lines(lines)

            if test_key_queue is not None:
                key = test_key_queue.pop(0) if test_key_queue else "ESC"
            else:
                key = read_key(fd)
            state.handle_key(key)

    except KeyboardInterrupt:
        state.cancelled = True
    finally:
        if not IS_WINDOWS and old_settings is not None:
            with contextlib.suppress(OSError, Exception):
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        clear_ui()

        if (
            not state.cancelled
            and state.target_path
            and not write_output(
                state.target_path,
                cwd_file,
                cmd_escape="--cmd-cwd-file" in sys.argv,
            )
        ):
            sys.exit(1)


if __name__ == "__main__":
    main()
