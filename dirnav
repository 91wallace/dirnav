def layout_ui_lines(lines, terminal_rows):
    """Anchor the last line (footer) near the terminal bottom while reserving a prompt row."""
    if not lines:
        return []
    usable_rows = max(1, terminal_rows - 1)
    if len(lines) > usable_rows:
        lines = lines[: usable_rows - 1] + [lines[-1]]
    content, footer = lines[:-1], lines[-1]
    padding = max(0, usable_rows - len(lines))
    return content + ([""] * padding) + [footer]


def read_key(fd, timeout=None):
    """Le uma tecla do terminal de forma compativel com Windows (UTF-16/UTF-8) e Unix."""
    if IS_WINDOWS:
        deadline = None if timeout is None else time.monotonic() + timeout
        while not msvcrt.kbhit():
            if deadline is not None and time.monotonic() >= deadline:
                return None
            time.sleep(0.02)
        # getwch() retorna string Unicode diretamente no Windows, resolvendo acentos e multi-byte
        ch = msvcrt.getwch()
        if ch in ("\x00", "\xe0"):
            ch2 = msvcrt.getwch()
            function_keys = {
                59: "F1",
                63: "F5",
                64: "F6",
                65: "F7",
                66: "F8",
                133: "F11",
                134: "F12",
            }
            if ord(ch2) in function_keys:
                return function_keys[ord(ch2)]
            if ch2 == "H":
                return "UP"
            elif ch2 == "P":
                return "DOWN"
            elif ch2 == "M":
                return "RIGHT"
            elif ch2 == "K":
                return "LEFT"
            elif ch2 == "G":
                return "HOME"
            elif ch2 == "O":
                return "END"
            elif ch2 == "I":
                return "PAGEUP"
            elif ch2 == "Q":
                return "PAGEDOWN"
            elif ch2 == "S":
                return "DELETE"  # Delete key isolada do Backspace
            return ""
        if ch == "\x03":
            return "\x03"
        if ch == "\x1b":
            return "ESC"
        if ch in ("\r", "\n"):
            return "\n"
        if ch in ("\x08", "\x7f"):
            return "\b"
        if ch == "\t":
            return "TAB"
        return ch
    else:
        if timeout is not None:
            ready, _, _ = select.select([fd], [], [], timeout)
            if not ready:
                return None
        b = os.read(fd, 1)
        if not b:
            return ""
        if b == b"\x03":
            return "\x03"
        if b == b"\x1b":
            r, _, _ = select.select([fd], [], [], 0.15)
            if r:
                b2 = os.read(fd, 1)
                seq = b + b2
                if b2 in (b"[", b"O"):
                    while True:
                        r2, _, _ = select.select([fd], [], [], 0.05)
                        if not r2:
                            break
                        bn = os.read(fd, 1)
                        seq += bn
                        if bn.isalpha() or bn == b"~":
                            break
                if seq in (b"\x1b[A", b"\x1bOA"):
                    return "UP"
                elif seq in (b"\x1b[B", b"\x1bOB"):
                    return "DOWN"
                elif seq in (b"\x1b[C", b"\x1bOC"):
                    return "RIGHT"
                elif seq in (b"\x1b[D", b"\x1bOD"):
                    return "LEFT"
                elif seq in (b"\x1b[H", b"\x1bOH", b"\x1b[1~", b"\x1b[7~"):
                    return "HOME"
                elif seq in (b"\x1b[F", b"\x1bOF", b"\x1b[4~", b"\x1b[8~"):
                    return "END"
                elif seq == b"\x1b[5~":
                    return "PAGEUP"
                elif seq == b"\x1b[6~":
                    return "PAGEDOWN"
                elif seq == b"\x1b[3~":
                    return "DELETE"
                elif seq in (b"\x1bOP", b"\x1b[11~"):
                    return "F1"
                elif seq == b"\x1b[15~":
                    return "F5"
                elif seq == b"\x1b[17~":
                    return "F6"
                elif seq == b"\x1b[18~":
                    return "F7"
                elif seq == b"\x1b[19~":
                    return "F8"
                return ""
            return "ESC"
        if b in (b"\r", b"\n"):
            return "\n"
        if b in (b"\x08", b"\x7f"):
            return "\b"
        if b == b"\t":
            return "TAB"

        # Decodifica sequencias UTF-8 multi-byte no Unix
        first_byte = b[0]
        extra_bytes = 0
        if (first_byte & 0xE0) == 0xC0:
            extra_bytes = 1
        elif (first_byte & 0xF0) == 0xE0:
            extra_bytes = 2
        elif (first_byte & 0xF8) == 0xF0:
            extra_bytes = 3

        for _ in range(extra_bytes):
            r_utf, _, _ = select.select([fd], [], [], 0.05)
            if r_utf:
                b += os.read(fd, 1)

        return b.decode("utf-8", errors="replace")


class NavigatorState:
    """Maquina de estados desacoplada para navegacao e filtragem de diretorios."""

    def __init__(self, start_path, max_lines=8):
        self.current_path = os.path.abspath(start_path)
        self.search_query = ""
        self.selected_idx = 0
        self.scroll_offset = 0
        self.max_lines = max_lines
        self.cancelled = False
        self.finished = False
        self.target_path = None
        self.status_message = ""
        self.show_files = False
        self.show_hidden_files = False
        self.all_dirs = []
        self.filtered_dirs = []
        self.refresh_dirs()

    def refresh_dirs(self):
        self.all_dirs = get_entries(
            self.current_path, self.show_files, self.show_hidden_files
        )
        self.apply_filter()

    def _refresh_preserving_selection(self):
        selected = (
            self.filtered_dirs[self.selected_idx]
            if self.filtered_dirs and 0 <= self.selected_idx < len(self.filtered_dirs)
            else None
        )
        self.refresh_dirs()
        if selected in self.filtered_dirs:
            self.selected_idx = self.filtered_dirs.index(selected)
            self.apply_filter()

    def toggle_files(self):
        self.show_files = not self.show_files
        self._refresh_preserving_selection()
        self.status_message = (
            "Arquivos exibidos."
            if self.show_files
            else "Somente diretorios exibidos."
        )

    def toggle_hidden_files(self):
        self.show_hidden_files = not self.show_hidden_files
        self._refresh_preserving_selection()
        self.status_message = (
            "Arquivos ocultos e do sistema serao exibidos com os arquivos."
            if self.show_hidden_files
            else "Arquivos ocultos e do sistema serao ocultados."
        )

    def apply_filter(self):
        self.filtered_dirs = filter_directories(self.all_dirs, self.search_query)
        (
            self.selected_idx,
            self.scroll_offset,
            _,
            _,
            _,
        ) = compute_viewport(
            len(self.filtered_dirs),
            self.selected_idx,
            self.scroll_offset,
            self.max_lines,
        )

    def handle_key(self, key):
        """Processa uma tecla e atualiza o estado."""
        if not key:
            return
        self.status_message = ""

        if key == "F7":
            self.toggle_files()
            return
        if key == "F8":
            self.toggle_hidden_files()
            return

        if key == "UP":
            if self.selected_idx > 0:
                self.selected_idx -= 1
                self.apply_filter()

        elif key == "DOWN":
            if self.selected_idx < len(self.filtered_dirs) - 1:
                self.selected_idx += 1
                self.apply_filter()

        elif key == "LEFT":
            # Seta para a esquerda: sobe para o diretorio pai e limpa a pesquisa
            parent = os.path.dirname(self.current_path)
            if parent and parent != self.current_path:
                self.current_path = parent
                self.search_query = ""
                self.selected_idx = 0
                self.scroll_offset = 0
                self.refresh_dirs()

        elif key in ("RIGHT", "TAB"):
            # Seta para a direita ou TAB: entra na subpasta selecionada
            if self.filtered_dirs and 0 <= self.selected_idx < len(self.filtered_dirs):
                new_path = os.path.join(
                    self.current_path, self.filtered_dirs[self.selected_idx]
                )
                if os.path.isdir(new_path):
                    self.current_path = new_path
                    self.search_query = ""
                    self.selected_idx = 0
                    self.scroll_offset = 0
                    self.refresh_dirs()
                else:
                    self.status_message = "Arquivo selecionado. Use F5, F6 ou Del."

        elif key in ("\r", "\n"):
            # Enter: vai direto para o diretorio selecionado na lista (evitando precisar entrar antes)
            if self.filtered_dirs and 0 <= self.selected_idx < len(self.filtered_dirs):
                candidate = os.path.join(
                    self.current_path, self.filtered_dirs[self.selected_idx]
                )
                if os.path.isdir(candidate):
                    self.target_path = candidate
                    self.finished = True
                else:
                    self.status_message = "Arquivo selecionado. Use F5, F6 ou Del."
            elif not self.search_query:
                # Se a pasta atual nao tiver subpastas e nao houver filtro sem resultado, mantem na atual
                self.target_path = self.current_path
                self.finished = True

        elif key == "\b":
            # Backspace: se houver pesquisa ativa, apaga o ultimo caractere;
            # se nao houver pesquisa, confirma e mantem no diretorio atual (current_path)
            if self.search_query:
                self.search_query = self.search_query[:-1]
                self.selected_idx = 0
                self.scroll_offset = 0
                self.apply_filter()
            else:
                self.target_path = self.current_path
                self.finished = True

        elif key == "HOME":
            self.selected_idx = 0
            self.scroll_offset = 0
            self.apply_filter()

        elif key == "END":
            if self.filtered_dirs:
                self.selected_idx = len(self.filtered_dirs) - 1
                self.apply_filter()

        elif key == "PAGEUP":
            self.selected_idx = max(0, self.selected_idx - self.max_lines)
            self.apply_filter()

        elif key == "PAGEDOWN":
            if self.filtered_dirs:
                self.selected_idx = min(
                    len(self.filtered_dirs) - 1, self.selected_idx + self.max_lines
                )
                self.apply_filter()

        elif key in ("ESC", "\x03"):
            # ESC ou Ctrl+C: sai imediatamente sem nenhuma alteracao
            self.cancelled = True
            self.target_path = None
            self.finished = True

        elif len(key) == 1 and key.isprintable():
            # Qualquer tecla imprimivel (incluindo 'q', espaco, letras, numeros, simbolos) filtra a lista
            self.search_query += key
            self.selected_idx = 0
            self.scroll_offset = 0
            self.apply_filter()


class FileOperationController:
    """Small interaction state machine for destination, conflict, and confirmation UI."""

    def __init__(self, navigator, action):
        self.navigator = navigator
        self.action = action
        if not navigator.filtered_dirs or not 0 <= navigator.selected_idx < len(
            navigator.filtered_dirs
        ):
            raise OperationError("Selecione um arquivo ou diretorio primeiro")
        self.source = os.path.abspath(
            os.path.join(
                navigator.current_path,
                navigator.filtered_dirs[navigator.selected_idx],
            )
        )
        self.source_snapshot = inspect_entry(self.source)
        self.destination_navigator = None
        self.target = None
        self.target_snapshot = None
        self.conflict_action = None
        self.phase = "confirm" if action == "delete" else "destination"
        self.done = False
        self.cancel_requested = False
        self.message = ""
        self.progress_text = ""
        self._last_progress_redraw = 0.0

        if action not in ("copy", "move", "delete"):
            raise ValueError(f"Unknown file operation: {action}")
        if action == "delete":
            validate_delete_target(
                self.source,
                self.source_snapshot,
                protected_paths=(navigator.current_path,),
            )
            self.summary = deletion_summary(self.source)
        else:
            self.destination_navigator = NavigatorState(navigator.current_path)

    @property
    def is_destination_phase(self):
        return self.phase == "destination"

    def _select_destination(self):
        destination = self.destination_navigator.current_path
        if self.source_snapshot["kind"] == "directory":
            source_real = os.path.normcase(os.path.realpath(self.source))
            destination_real = os.path.normcase(os.path.realpath(destination))
            try:
                if os.path.commonpath((destination_real, source_real)) == source_real:
                    raise OperationError(
                        "Nao e possivel copiar ou mover um diretorio para dentro dele mesmo"
                    )
            except ValueError:
                pass
        name = os.path.basename(self.source.rstrip(os.sep))
        if not name or name in (".", ".."):
            raise OperationError("Nao foi possivel determinar um nome seguro para o destino")
        self.target = os.path.abspath(os.path.join(destination, name))
        self.destination_snapshot = inspect_entry(destination)
        if self.destination_snapshot["kind"] != "directory":
            raise OperationError("O destino selecionado deixou de ser um diretorio")
        if os.path.lexists(self.target):
            self.target_snapshot = inspect_entry(self.target)
            self.phase = "conflict"
        else:
            self.phase = "confirm"

    def _rename_target(self):
        destination = os.path.dirname(self.target)
        label = "copy" if self.action == "copy" else "moved"
        self.target = unique_destination_path(
            destination, os.path.basename(self.target), label
        )
        self.target_snapshot = None
        self.conflict_action = None
        self.phase = "confirm"

    def handle_key(self, key):
        if self.done or not key:
            return
        if self.phase == "destination":
            if key in ("ESC", "\x03"):
                self.done = True
                self.message = "Operacao cancelada; nenhum arquivo foi alterado."
            elif key in ("\r", "\n"):
                try:
                    self._select_destination()
                except (OSError, OperationError) as exc:
                    self.message = str(exc)
                    self.destination_navigator.status_message = self.message
            elif key == "\b":
                if self.destination_navigator.search_query:
                    self.destination_navigator.handle_key(key)
            elif key in ("UP", "DOWN", "LEFT", "RIGHT", "TAB", "HOME", "END", "PAGEUP", "PAGEDOWN", "F7", "F8") or (
                len(key) == 1 and key.isprintable()
            ):
                self.destination_navigator.handle_key(key)
            return

        if self.phase == "conflict":
            if key in ("ESC", "\x03"):
                self.done = True
                self.message = "Operacao cancelada; o destino foi preservado."
            elif len(key) == 1 and key.casefold() == "r":
                self._rename_target()
            elif (
                self.phase == "conflict"
                and self.action == "copy"
                and len(key) == 1
                and key.casefold() == "s"
            ):
                self.conflict_action = "replace"
                self.phase = "confirm"
            return

        if self.phase == "confirm":
            if key in ("ESC", "\x03"):
                self.done = True
                self.message = "Operacao cancelada; nenhum arquivo foi alterado."
            elif key in ("\r", "\n"):
                self.phase = "running"

    def execute(self, progress=None, cancel=None):
        try:
            if self.action == "delete":
                self.message = delete_entry(
                    self.source,
                    expected_source=self.source_snapshot,
                    protected_paths=(self.navigator.current_path,),
                )
            elif self.action == "copy":
                self.message = copy_entry(
                    self.source,
                    self.target,
                    replace=self.conflict_action == "replace",
                    expected_source=self.source_snapshot,
                    expected_target=self.target_snapshot,
                    destination_dir=os.path.dirname(self.target),
                    expected_destination=self.destination_snapshot,
                    progress=progress,
                    cancel=cancel,
                )
            else:
                self.message = move_entry(
                    self.source,
                    self.target,
                    expected_source=self.source_snapshot,
                    destination_dir=os.path.dirname(self.target),
                    expected_destination=self.destination_snapshot,
                    progress=progress,
                    cancel=cancel,
                )
        except OperationCancelled:
            self.message = "Operacao cancelada; o item original foi preservado."
        except (OSError, OperationError) as exc:
            self.message = f"Falha na operacao: {exc}"
        self.done = True

    def screen_lines(self, columns, rows):
        source_name = os.path.basename(self.source.rstrip(os.sep)) or self.source
        if self.phase == "destination":
            return None
        lines = []
        if self.action == "delete":
            lines.extend(
                (
                    "Excluir permanentemente o item selecionado?",
                    sanitize_terminal_text(source_name),
                )
            )
            if self.source_snapshot["kind"] == "directory":
                lines.append(
                    f"A exclusao e recursiva: {self.summary['files']} arquivos, "
                    f"{self.summary['directories']} diretorios e "
                    f"{self.summary['links']} links/junctions."
                )
            lines.append("A operacao e permanente e nao usa lixeira.")
        elif self.phase == "conflict":
            lines.extend(
                (
                    "Ja existe um item com este nome no destino:",
                    sanitize_terminal_text(self.target),
                )
            )
            lines.append(
                "S substituir | R renomear para uma copia numerada | Esc cancelar"
                if self.action == "copy"
                else "R escolher um nome numerado | Esc cancelar (nao ha substituicao para mover)"
            )
        else:
            verb = "Copiar" if self.action == "copy" else "Mover"
            lines.extend(
                (
                    f"{verb} este item?",
                    f"Origem: {sanitize_terminal_text(self.source)}",
                    f"Destino: {sanitize_terminal_text(self.target)}",
                )
            )
            if self.source_snapshot["kind"] in ("symlink", "junction"):
                lines.append("O link sera tratado como um item; seu alvo nao sera percorrido.")
            lines.append("Enter confirmar | Esc cancelar")
        max_content = max(1, rows - 2)
        return [truncate_text(line, columns) for line in lines[:max_content]]


def get_powershell_integration_block(shortcut="dn"):
    return f"""# Dirnav shell integration
function {shortcut} {{
    param(
        [Parameter(Position=0, ValueFromRemainingArguments=$true)]
        [string]$Path
    )

    $tmp = [System.IO.Path]::Combine([System.IO.Path]::GetTempPath(), "dirnav-cwd-$([guid]::NewGuid().ToString('N')).tmp")
    try {{
        $installedExe = Join-Path $env:LOCALAPPDATA "Microsoft\\WinGet\\Links\\dirnav.exe"
        $installedPy = Join-Path $env:LOCALAPPDATA "Programs\\dirnav\\dirnav.py"
        if (Get-Command "dirnav.exe" -ErrorAction SilentlyContinue) {{
            if ($Path) {{
                dirnav.exe --cwd-file "$tmp" "$Path"
            }} else {{
                dirnav.exe --cwd-file "$tmp"
            }}
        }} elseif (Test-Path -LiteralPath $installedExe) {{
            if ($Path) {{
                & $installedExe --cwd-file "$tmp" "$Path"
            }} else {{
                & $installedExe --cwd-file "$tmp"
            }}
        }} elseif (Test-Path -LiteralPath $installedPy) {{
            $pyExe = if (Get-Command "py" -ErrorAction SilentlyContinue) {{ "py" }} else {{ "python" }}
            if ($Path) {{
                & $pyExe "$installedPy" --cwd-file "$tmp" "$Path"
            }} else {{
                & $pyExe "$installedPy" --cwd-file "$tmp"
            }}
        }} else {{
            if ($Path) {{
                dirnav --cwd-file "$tmp" "$Path"
            }} else {{
                dirnav --cwd-file "$tmp"
            }}
        }}
        if (Test-Path -LiteralPath $tmp) {{
            $raw = [System.IO.File]::ReadAllText($tmp, [System.Text.Encoding]::UTF8)
            if ($null -ne $raw) {{
                $target = $raw.Trim()
                if ($target -and (Test-Path -LiteralPath $target -PathType Container)) {{
                    Set-Location -LiteralPath $target
                }}
            }}
        }}
    }} finally {{
        if (Test-Path -LiteralPath $tmp) {{
            Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
        }}
    }}
}}
Set-Alias -Name dirnav -Value {shortcut} -Option AllScope -Force -ErrorAction SilentlyContinue
Set-Alias -Name cc -Value {shortcut} -Option AllScope -Force -ErrorAction SilentlyContinue
# END Dirnav shell integration"""


def get_posix_integration_block(shortcut="dn"):
    return f"""# Dirnav shell integration
function {shortcut}() {{
    local tmp
    tmp="$(mktemp -t "dirnav-cwd.XXXXXX")"
    local dirnav_status=0
    command dirnav --cwd-file="$tmp" "$@" || dirnav_status=$?
    local cd_status=0
    if [ "$dirnav_status" -eq 0 ] && [ -s "$tmp" ]; then
        local target
        target="$(cat "$tmp")"
        if [ -n "$target" ] && [ -d "$target" ]; then
            builtin cd -- "$target" || cd_status=$?
        fi
    fi
    rm -f "$tmp" || true
    if [ "$dirnav_status" -ne 0 ]; then
        return "$dirnav_status"
    fi
    return "$cd_status"
}}
alias dirnav={shortcut}
if ! command -v cc >/dev/null 2>&1 || [ "$(type -t cc 2>/dev/null)" = "alias" ]; then
    alias cc={shortcut}
fi
# END Dirnav shell integration"""


def get_target_profiles():
    """Retorna a lista de arquivos de perfil do shell para o sistema atual."""
    env_prof = os.environ.get("DIRNAV_TEST_PROFILE")
    if env_prof:
        return [p for p in env_prof.split(os.pathsep) if p]

    home = os.path.expanduser("~")
    if IS_WINDOWS:
        docs = os.path.join(home, "Documents")
        return [
            os.path.join(docs, "PowerShell", "Microsoft.PowerShell_profile.ps1"),
            os.path.join(docs, "PowerShell", "profile.ps1"),
            os.path.join(docs, "WindowsPowerShell", "Microsoft.PowerShell_profile.ps1"),
            os.path.join(docs, "WindowsPowerShell", "profile.ps1"),
        ]
    return [
        os.path.join(home, ".bashrc"),
        os.path.join(home, ".zshrc"),
    ]


def setup_shell_integration(shortcut="dn"):
    """Injeta de forma idempotente a integracao de shell nos perfis do usuario."""
    profiles = get_target_profiles()
    block = (
        get_powershell_integration_block(shortcut)
        if IS_WINDOWS
        else get_posix_integration_block(shortcut)
    )
    pattern = re.compile(
        r"# Dirnav shell integration.*?# END Dirnav shell integration\r?\n?|# Dirnav shell integration\s+function \w+\b.*?(?:Set-Alias -Name cc[^\r\n]*\r?\n?|alias cc=[^\r\n]*\r?\n?|fi\r?\n?)",
        re.DOTALL,
    )

    updated = []
    for prof in profiles:
        with contextlib.suppress(OSError):
            prof_dir = os.path.dirname(prof)
            if prof_dir and not os.path.exists(prof_dir):
                os.makedirs(prof_dir, exist_ok=True)
            content = ""
            if os.path.exists(prof):
                with open(prof, encoding="utf-8", errors="replace") as f:
                    content = f.read()
            if "# Dirnav shell integration" in content:
                content = pattern.sub("", content)
            new_content = (
                (content.strip() + "\n\n" + block + "\n")
                if content.strip()
                else (block + "\n")
            )
            with open(prof, "w", encoding="utf-8") as f:
                f.write(new_content)
            updated.append(prof)
    return updated


def uninstall_shell_integration():
    """Remove de forma limpa a integracao de shell dos perfis do usuario."""
    profiles = get_target_profiles()
    pattern = re.compile(
        r"# Dirnav shell integration.*?# END Dirnav shell integration\r?\n?|# Dirnav shell integration\s+function \w+\b.*?(?:Set-Alias -Name cc[^\r\n]*\r?\n?|Set-Alias -Name dirnav[^\r\n]*\r?\n?|alias cc=[^\r\n]*\r?\n?|fi\r?\n?)+",
        re.DOTALL,
    )
    orphan_alias_pattern = re.compile(
        r"^Set-Alias -Name (dirnav|cc) -Value \w+ -Option AllScope.*?\r?\n?",
        re.MULTILINE,
    )

    cleaned = []
    for prof in profiles:
        if os.path.exists(prof):
            with contextlib.suppress(OSError):
                with open(prof, encoding="utf-8", errors="replace") as f:
                    content = f.read()
                if "# Dirnav shell integration" in content or "--cwd-file" in content:
                    new_content = pattern.sub("", content)
                    new_content = orphan_alias_pattern.sub("", new_content)
                    with open(prof, "w", encoding="utf-8") as f:
                        f.write(
                            new_content.strip() + ("\n" if new_content.strip() else "")
                        )
                    cleaned.append(prof)
    return cleaned


def parse_args(argv):
    """Analisa os argumentos de linha de comando."""
    cwd_file = None
    start_path = None
    action = None

    i = 1
    while i < len(argv):
        arg = argv[i]
        if arg in ("--version", "-v"):
            action = "version"
            i += 1
        elif arg in ("--setup", "--init"):
            action = "setup"
            i += 1
        elif arg == "--uninstall":
            action = "uninstall"
            i += 1
        elif arg in ("--help", "-h"):
            action = "help"
            i += 1
        elif arg in ("--cwd-file", "--cmd-cwd-file") and i + 1 < len(argv):
            cwd_file = argv[i + 1]
            i += 2
        elif arg.startswith(("--cwd-file=", "--cmd-cwd-file=")):
            cwd_file = arg.split("=", 1)[1]
            i += 1
        else:
            expanded = os.path.expanduser(arg)
            if os.path.isdir(expanded):
                start_path = os.path.abspath(expanded)
            i += 1

    return cwd_file, start_path, action


def _win32_security_api():
    if os.name != "nt":
        raise OSError("CMD secure transport requires Windows")
    from ctypes import wintypes

    advapi = ctypes.WinDLL("advapi32", use_last_error=True)
    kernel = ctypes.WinDLL("kernel32", use_last_error=True)

    class SecurityAttributes(ctypes.Structure):
        _fields_ = [
            ("nLength", wintypes.DWORD),
            ("lpSecurityDescriptor", wintypes.LPVOID),
            ("bInheritHandle", wintypes.BOOL),
        ]

    class SidAndAttributes(ctypes.Structure):
        _fields_ = [("Sid", wintypes.LPVOID), ("Attributes", wintypes.DWORD)]

    class TokenUser(ctypes.Structure):
        _fields_ = [("User", SidAndAttributes)]

    class AceHeader(ctypes.Structure):
        _fields_ = [
            ("AceType", ctypes.c_ubyte),
            ("AceFlags", ctypes.c_ubyte),
            ("AceSize", wintypes.WORD),
        ]

    class AclSizeInformation(ctypes.Structure):
        _fields_ = [
            ("AceCount", wintypes.DWORD),
            ("AclBytesInUse", wintypes.DWORD),
            ("AclBytesFree", wintypes.DWORD),
        ]

    advapi.OpenProcessToken.argtypes = [wintypes.HANDLE, wintypes.DWORD, ctypes.POINTER(wintypes.HANDLE)]
    advapi.OpenProcessToken.restype = wintypes.BOOL
    advapi.GetTokenInformation.argtypes = [wintypes.HANDLE, ctypes.c_int, wintypes.LPVOID, wintypes.DWORD, ctypes.POINTER(wintypes.DWORD)]
    advapi.GetTokenInformation.restype = wintypes.BOOL
    advapi.ConvertSidToStringSidW.argtypes = [wintypes.LPVOID, ctypes.POINTER(wintypes.LPWSTR)]
    advapi.ConvertSidToStringSidW.restype = wintypes.BOOL
    advapi.ConvertStringSecurityDescriptorToSecurityDescriptorW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, ctypes.POINTER(wintypes.LPVOID), ctypes.POINTER(wintypes.DWORD)]
    advapi.ConvertStringSecurityDescriptorToSecurityDescriptorW.restype = wintypes.BOOL
    kernel.CreateDirectoryW.argtypes = [wintypes.LPCWSTR, ctypes.POINTER(SecurityAttributes)]
    kernel.CreateDirectoryW.restype = wintypes.BOOL
    advapi.GetNamedSecurityInfoW.argtypes = [wintypes.LPWSTR, wintypes.DWORD, wintypes.DWORD, ctypes.POINTER(wintypes.LPVOID), ctypes.POINTER(wintypes.LPVOID), ctypes.POINTER(wintypes.LPVOID), ctypes.POINTER(wintypes.LPVOID), ctypes.POINTER(wintypes.LPVOID)]
    advapi.GetNamedSecurityInfoW.restype = wintypes.DWORD
    advapi.GetSecurityDescriptorControl.argtypes = [wintypes.LPVOID, ctypes.POINTER(wintypes.WORD), ctypes.POINTER(wintypes.DWORD)]
    advapi.GetSecurityDescriptorControl.restype = wintypes.BOOL
    advapi.GetAclInformation.argtypes = [wintypes.LPVOID, wintypes.LPVOID, wintypes.DWORD, ctypes.c_int]
    advapi.GetAclInformation.restype = wintypes.BOOL
    advapi.GetAce.argtypes = [wintypes.LPVOID, wintypes.DWORD, ctypes.POINTER(wintypes.LPVOID)]
    advapi.GetAce.restype = wintypes.BOOL
    kernel.GetCurrentProcess.restype = wintypes.HANDLE
    kernel.LocalFree.argtypes = [wintypes.HLOCAL]
    kernel.LocalFree.restype = wintypes.HLOCAL
    kernel.CloseHandle.argtypes = [wintypes.HANDLE]
    kernel.CloseHandle.restype = wintypes.BOOL
    kernel.CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, ctypes.POINTER(SecurityAttributes), wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
    kernel.CreateFileW.restype = wintypes.HANDLE
    kernel.WriteFile.argtypes = [wintypes.HANDLE, wintypes.LPCVOID, wintypes.DWORD, ctypes.POINTER(wintypes.DWORD), wintypes.LPVOID]
    kernel.WriteFile.restype = wintypes.BOOL
    kernel.FlushFileBuffers.argtypes = [wintypes.HANDLE]
    kernel.FlushFileBuffers.restype = wintypes.BOOL
    kernel.DeleteFileW.argtypes = [wintypes.LPCWSTR]
    kernel.DeleteFileW.restype = wintypes.BOOL
    kernel.RemoveDirectoryW.argtypes = [wintypes.LPCWSTR]
    kernel.RemoveDirectoryW.restype = wintypes.BOOL
    kernel.GetFileAttributesW.argtypes = [wintypes.LPCWSTR]
    kernel.GetFileAttributesW.restype = wintypes.DWORD
    return advapi, kernel, SecurityAttributes, TokenUser, AceHeader, AclSizeInformation


def _windows_current_user_sid(advapi, kernel, TokenUser):
    from ctypes import wintypes

    token = wintypes.HANDLE()
    if not advapi.OpenProcessToken(kernel.GetCurrentProcess(), 0x0008, ctypes.byref(token)):
        raise ctypes.WinError(ctypes.get_last_error())
    try:
        required = wintypes.DWORD()
        advapi.GetTokenInformation(token, 1, None, 0, ctypes.byref(required))
        buffer = ctypes.create_string_buffer(required.value)
        if not advapi.GetTokenInformation(token, 1, buffer, required, ctypes.byref(required)):
            raise ctypes.WinError(ctypes.get_last_error())
        sid_ptr = ctypes.cast(buffer, ctypes.POINTER(TokenUser)).contents.User.Sid
        sid_text = wintypes.LPWSTR()
        if not advapi.ConvertSidToStringSidW(sid_ptr, ctypes.byref(sid_text)):
            raise ctypes.WinError(ctypes.get_last_error())
        try:
            return sid_text.value
        finally:
            kernel.LocalFree(sid_text)
    finally:
        kernel.CloseHandle(token)


def _windows_security_descriptor(advapi, SecurityAttributes, sddl):
    from ctypes import wintypes

    descriptor = wintypes.LPVOID()
    size = wintypes.DWORD()
    if not advapi.ConvertStringSecurityDescriptorToSecurityDescriptorW(
        sddl, 1, ctypes.byref(descriptor), ctypes.byref(size)
    ):
        raise ctypes.WinError(ctypes.get_last_error())
    attributes = SecurityAttributes(
        ctypes.sizeof(SecurityAttributes), descriptor, False
    )
    return descriptor, attributes


def _windows_security_snapshot(advapi, kernel, path, AclSizeInformation, AceHeader):
    from ctypes import wintypes

    owner = wintypes.LPVOID()
    dacl = wintypes.LPVOID()
    descriptor = wintypes.LPVOID()
    status = advapi.GetNamedSecurityInfoW(
        path,
        1,  # SE_FILE_OBJECT
        0x00000001 | 0x00000004,  # OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION
        ctypes.byref(owner),
        None,
        ctypes.byref(dacl),
        None,
        ctypes.byref(descriptor),
    )
    if status:
        raise ctypes.WinError(status)
    try:
        if not dacl.value:
            raise OSError("object has a NULL DACL")
        control = wintypes.WORD()
        revision = wintypes.DWORD()
        if not advapi.GetSecurityDescriptorControl(
            descriptor, ctypes.byref(control), ctypes.byref(revision)
        ):
            raise ctypes.WinError(ctypes.get_last_error())
        info = AclSizeInformation()
        if not advapi.GetAclInformation(
            dacl, ctypes.byref(info), ctypes.sizeof(info), 2
        ):
            raise ctypes.WinError(ctypes.get_last_error())

        def sid_string(sid_ptr):
            sid_text = wintypes.LPWSTR()
            if not advapi.ConvertSidToStringSidW(sid_ptr, ctypes.byref(sid_text)):
                raise ctypes.WinError(ctypes.get_last_error())
            try:
                return sid_text.value
            finally:
                kernel.LocalFree(sid_text)

        owner_sid = sid_string(owner)
        aces = []
        for index in range(info.AceCount):
            ace_ptr = wintypes.LPVOID()
            if not advapi.GetAce(dacl, index, ctypes.byref(ace_ptr)):
                raise ctypes.WinError(ctypes.get_last_error())
            header = ctypes.cast(ace_ptr, ctypes.POINTER(AceHeader)).contents
            if header.AceType != 0:  # only ACCESS_ALLOWED_ACE is accepted
                raise OSError("unexpected or deny ACE in secure artifact DACL")
            mask = wintypes.DWORD.from_address(ace_ptr.value + 4).value
            # ACCESS_ALLOWED_ACE stores the SID inline after its mask, not a pointer.
            sid_ptr = ace_ptr.value + 8
            aces.append((sid_string(sid_ptr), mask, header.AceFlags))
        return owner_sid, bool(control.value & 0x1000), aces
    finally:
        kernel.LocalFree(descriptor)


def _windows_verify_artifact(advapi, kernel, path, owner_sid, expected_aces, is_directory):
    _, _, _, _, AceHeader, AclSizeInformation = _win32_security_api()
    actual_owner, protected, actual_aces = _windows_security_snapshot(
        advapi, kernel, path, AclSizeInformation, AceHeader
    )
    if actual_owner != owner_sid:
        raise OSError("secure artifact owner does not match current user")
    if not protected:
        raise OSError("secure artifact DACL is not protected")
    if sorted(actual_aces) != sorted(expected_aces):
        raise OSError("secure artifact DACL differs from the explicit allowlist")
    attributes = kernel.GetFileAttributesW(path)
    if attributes == 0xFFFFFFFF:
        raise ctypes.WinError(ctypes.get_last_error())
    if attributes & 0x400:  # FILE_ATTRIBUTE_REPARSE_POINT
        raise OSError("secure artifact unexpectedly became a reparse point")
    if is_directory and not attributes & 0x10:  # FILE_ATTRIBUTE_DIRECTORY
        raise OSError("secure artifact is not a directory")
    return actual_aces


def create_secure_cmd_temp_directory():
    """Atomically create and verify the private CMD artifact directory."""
    if os.name != "nt":
        raise OSError("secure CMD artifact directories require Windows")
    root = os.path.abspath(os.environ.get("USERPROFILE", ""))
    if not root or not os.path.isdir(root):
        raise OSError("USERPROFILE is missing or unavailable")
    advapi, kernel, SecurityAttributes, TokenUser, AceHeader, AclSizeInformation = _win32_security_api()
    user_sid = _windows_current_user_sid(advapi, kernel, TokenUser)
    system_sid = "S-1-5-18"
    admin_sid = "S-1-5-32-544"
    allowed_sids = {user_sid, system_sid, admin_sid}
    parent_owner, parent_protected, parent_aces = _windows_security_snapshot(
        advapi, kernel, root, AclSizeInformation, AceHeader
    )
    parent_attributes = kernel.GetFileAttributesW(root)
    if parent_attributes == 0xFFFFFFFF or parent_attributes & 0x400:
        raise OSError("USERPROFILE parent is unavailable or a reparse point")
    if not parent_protected:
        raise OSError("USERPROFILE parent DACL is not protected")
    if parent_owner not in allowed_sids:
        raise OSError("USERPROFILE owner is outside the trusted SID set")
    unsafe_parent_mask = 0x00000002 | 0x00000004 | 0x00000010 | 0x00000040 | 0x00000100 | 0x00010000 | 0x00040000 | 0x00080000 | 0x10000000 | 0x40000000
    if any(sid not in allowed_sids and mask & unsafe_parent_mask for sid, mask, _ in parent_aces):
        raise OSError("USERPROFILE parent grants write/delete rights to an untrusted SID")

    dir_sddl = f"O:{user_sid}G:SYD:P(A;OICI;FA;;;{user_sid})(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)"
    expected_dir_aces = [
        (user_sid, 0x001F01FF, 0x03),
        (system_sid, 0x001F01FF, 0x03),
        (admin_sid, 0x001F01FF, 0x03),
    ]
    descriptor, attributes = _windows_security_descriptor(advapi, SecurityAttributes, dir_sddl)
    try:
        for _ in range(20):
            token = secrets.token_hex(16)
            path = os.path.join(root, "dirnav-cmd-" + token)
            if kernel.CreateDirectoryW(path, ctypes.byref(attributes)):
                try:
                    _windows_verify_artifact(
                        advapi, kernel, path, user_sid, expected_dir_aces, True
                    )
                    return token
                except OSError:
                    kernel.RemoveDirectoryW(path)
                    raise
            error = ctypes.get_last_error()
            if error not in (80, 183):  # ERROR_FILE_EXISTS / ERROR_ALREADY_EXISTS
                raise ctypes.WinError(error)
        raise FileExistsError("unable to allocate a unique secure CMD directory")
    finally:
        kernel.LocalFree(descriptor)


def _write_secure_cmd_batch(cwd_file, script):
    advapi, kernel, SecurityAttributes, TokenUser, _, _ = _win32_security_api()
    user_sid = _windows_current_user_sid(advapi, kernel, TokenUser)
    path = os.path.abspath(cwd_file)
    root = os.path.abspath(os.environ.get("USERPROFILE", ""))
    parent = os.path.dirname(path)
    base = os.path.basename(parent)
    try:
        common = os.path.commonpath([root, parent])
    except ValueError as exc:
        raise OSError("CMD artifact path is outside the secure per-user directory") from exc
    if common.casefold() != root.casefold() or not re.fullmatch(r"dirnav-cmd-[0-9a-f]{32}", base):
        raise OSError("CMD artifact path is outside the secure per-user directory")
    expected_dir_aces = [
        (user_sid, 0x001F01FF, 0x03),
        ("S-1-5-18", 0x001F01FF, 0x03),
        ("S-1-5-32-544", 0x001F01FF, 0x03),
    ]
    _windows_verify_artifact(advapi, kernel, parent, user_sid, expected_dir_aces, True)
    file_sddl = f"O:{user_sid}G:SYD:P(A;;FA;;;{user_sid})(A;;FA;;;SY)(A;;FA;;;BA)"
    expected_file_aces = [
        (user_sid, 0x001F01FF, 0),
        ("S-1-5-18", 0x001F01FF, 0),
        ("S-1-5-32-544", 0x001F01FF, 0),
    ]
    descriptor, attributes = _windows_security_descriptor(advapi, SecurityAttributes, file_sddl)
    from ctypes import wintypes

    handle = wintypes.HANDLE(-1).value
    created = False
    try:
        handle = kernel.CreateFileW(path, 0x40000000, 0, ctypes.byref(attributes), 1, 0x100, None)
        if handle == wintypes.HANDLE(-1).value:
            raise ctypes.WinError(ctypes.get_last_error())
        created = True
        payload = script.encode("utf-8")
        offset = 0
        while offset < len(payload):
            written = wintypes.DWORD()
            block = payload[offset:]
            buffer = ctypes.create_string_buffer(block)
            if not kernel.WriteFile(handle, buffer, len(block), ctypes.byref(written), None):
                raise ctypes.WinError(ctypes.get_last_error())
            if written.value == 0:
                raise OSError("WriteFile returned zero bytes")
            offset += written.value
        if not kernel.FlushFileBuffers(handle):
            raise ctypes.WinError(ctypes.get_last_error())
        kernel.CloseHandle(handle)
        handle = wintypes.HANDLE(-1).value
        _windows_verify_artifact(advapi, kernel, path, user_sid, expected_file_aces, False)
    except Exception:
        if handle != wintypes.HANDLE(-1).value:
            kernel.CloseHandle(handle)
        if created:
            kernel.DeleteFileW(path)
        raise
    finally:
        kernel.LocalFree(descriptor)


def build_cmd_directory_script(path, codepage):
    """Build a quoted batch command that changes directory in the caller's CMD."""
    if any(char in path for char in ('"', "\r", "\n")):
        raise ValueError("invalid character for a Windows directory path")
    try:
        original_codepage = int(codepage)
    except (TypeError, ValueError):
        original_codepage = 437

    # Batch expansion remains active inside quotes. Generate separate literal
    # commands for /V:OFF and /V:ON so carets and exclamation marks survive both
    # parsers. The temporary probe variable is unpredictable and removed before
    # returning to the caller's environment.
    plain_path = path.replace("%", "%%")
    delayed_chars = []
    index = 0
    has_bang = "!" in path
    while index < len(path):
        if path[index : index + 2] == "^!":
            delayed_chars.append("^^^!")
            index += 2
        elif path[index] == "^":
            delayed_chars.append("^^" if has_bang else "^")
            index += 1
        elif path[index] == "!":
            delayed_chars.append("^!")
            index += 1
        else:
            delayed_chars.append("%%" if path[index] == "%" else path[index])
            index += 1
    delayed_path = "".join(delayed_chars)
    probe = "DIRNAV_DELAYED_" + secrets.token_hex(8).upper()
    return "\r\n".join(
        (
            "@echo off",
            "chcp 65001 >nul",
            f'set "{probe}=1"',
            f'if "!{probe}!"=="1" goto dirnav_delayed',
            f'set "{probe}="',
            "setlocal DisableDelayedExpansion",
            f'endlocal & cd /d "{plain_path}"',
            "goto dirnav_cd_result",
            ":dirnav_delayed",
            f'set "{probe}="',
            "setlocal DisableDelayedExpansion",
            f'endlocal & cd /d "{delayed_path}"',
            ":dirnav_cd_result",
            "if errorlevel 1 goto dirnav_cmd_failed",
            f"chcp {original_codepage} >nul",
            "exit /b 0",
            ":dirnav_cmd_failed",
            f"chcp {original_codepage} >nul",
            "exit /b 1",
            "",
        )
    )


def write_output(target_path, cwd_file, stdout_stream=None, cmd_escape=False):
    """
    Grava o caminho selecionado.
    Bug Critico 1 e 7 resolvidos: normaliza o caminho com abspath/normpath e,
    se cwd_file foi fornecido, grava EXCLUSIVAMENTE nele em UTF-8 sem BOM.
    """
    if not target_path:
        return True

    norm_target = os.path.normpath(os.path.abspath(target_path))

    if cwd_file:
        try:
            if cmd_escape:
                script = build_cmd_directory_script(
                    norm_target, os.environ.get("DIRNAV_CMD_CODEPAGE", "437")
                )
                _write_secure_cmd_batch(cwd_file, script)
            else:
                with open(cwd_file, "w", encoding="utf-8", newline="") as f:
                    f.write(norm_target)
        except OSError as exc:
            print(f"dirnav: nao foi possivel gravar o caminho selecionado: {exc}", file=sys.stderr)
            return False
    else:
        out = stdout_stream if stdout_stream is not None else sys.stdout
        out.write(norm_target + "\n")
        out.flush()
    return True


def main():
    if sys.argv[1:] == ["--cmd-create-temp"]:
        try:
            print(create_secure_cmd_temp_directory())
        except OSError as exc:
            print(f"dirnav: nao foi possivel criar diretorio CMD seguro: {exc}", file=sys.stderr)
            sys.exit(1)
        sys.exit(0)

    parsed = parse_args(sys.argv)
    if len(parsed) == 3:
        cwd_file, start_path, action = parsed
    else:
        cwd_file, start_path = parsed
        action = None

    if action == "version":
        print(f"dirnav {__version__}")
        sys.exit(0)
    elif action == "help":
        print(
            f"dirnav {__version__} - Navegador de diretorios inline\n"
            "Uso: dn [caminho] | cc [caminho] | dirnav [--setup|--uninstall|--version]"
        )
        sys.exit(0)
    elif action == "setup":
        updated = setup_shell_integration()
        for p in updated:
            print(f"[OK] Integracao configurada em: {p}")
        sys.exit(0)
    elif action == "uninstall":
        cleaned = uninstall_shell_integration()
        for p in cleaned:
            print(f"[OK] Integracao removida de: {p}")
        sys.exit(0)

    test_keys_env = os.environ.get("DIRNAV_TEST_KEYS")
    if not sys.stdin.isatty() and not test_keys_env:
        sys.exit(1)

    initial_path = start_path if start_path else os.getcwd()

    if test_keys_env:
        fd = None
        old_settings = None
        test_key_queue = [
            "\n" if k == "ENTER" else "\b" if k == "BACKSPACE" else k
            for k in test_keys_env.split(",")
            if k
        ]
    elif not IS_WINDOWS:
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        test_key_queue = None
    else:
        fd = None
        old_settings = None
        test_key_queue = None
        os.system("")  # habilita processamento ANSI no Windows Terminal / conhost

    ui_out = sys.stderr
    prev_line_count = 0
    last_render_signature = None

    def render_lines(lines, terminal_rows):
        nonlocal prev_line_count, last_render_signature
        if not lines:
            lines = ["\033[90m(nenhuma subpasta)\033[0m"]
        display_lines = layout_ui_lines(lines, terminal_rows)
        signature = (tuple(display_lines), terminal_rows)
        if signature == last_render_signature:
            return

        out = []
        if prev_line_count > 1:
            out.append(f"\033[{prev_line_count - 1}A\r")
        elif prev_line_count == 1:
            out.append("\r")

        for i, line in enumerate(display_lines):
            if i < len(display_lines) - 1:
                out.append(f"\033[2K{line}\r\n")
            else:
                out.append(f"\033[2K{line}")

        if prev_line_count > len(display_lines):
            diff = prev_line_count - len(display_lines)
            for _ in range(diff):
                out.append("\r\n\033[2K")
            out.append(f"\033[{diff}A\r")

        prev_line_count = len(display_lines)
        last_render_signature = signature
        ui_out.write("".join(out))
        ui_out.flush()

    def clear_ui():
        nonlocal prev_line_count
        out = []
        if prev_line_count > 0:
            if prev_line_count > 1:
                out.append(f"\033[{prev_line_count - 1}A\r")
            else:
                out.append("\r")

            for i in range(prev_line_count):
                if i < prev_line_count - 1:
                    out.append("\033[2K\r\n")
                else:
                    out.append("\033[2K")

            if prev_line_count > 1:
                out.append(f"\033[{prev_line_count - 1}A\r")
            else:
                out.append("\r")
            prev_line_count = 0

        # Sempre garante que o cursor volte a ficar visivel (Bug Critico 4 resolvido)
        out.append("\033[?25h")
        ui_out.write("".join(out))
        ui_out.flush()

    state = NavigatorState(initial_path)
    active_operation = None
    help_visible = False

    def render_current(term_size=None):
        if term_size is None:
            term_size = shutil.get_terminal_size((80, 24))
        rows = max(1, term_size.lines)
        columns = max(1, term_size.columns)
        if help_visible:
            lines = build_help_lines(columns, rows)
        elif active_operation is not None and active_operation.is_destination_phase:
            destination_state = active_operation.destination_navigator
            has_filter = bool(destination_state.search_query)
            item_rows = max(
                1,
                min(8, rows - 1 - 1 - 1 - int(has_filter)),
            )
            lines, destination_state.selected_idx, destination_state.scroll_offset = build_ui_lines(
                destination_state.current_path,
                destination_state.filtered_dirs,
                destination_state.selected_idx,
                destination_state.scroll_offset,
                item_rows,
                columns,
                destination_state.search_query,
                footer_text=build_footer(
                    columns,
                    "destination",
                    destination_state.show_files,
                    destination_state.show_hidden_files,
                ),
                heading=f"Destino para {active_operation.action}: selecione a pasta atual",
                status_message=destination_state.status_message,
            )
        elif active_operation is not None:
            lines = active_operation.screen_lines(columns, rows) or []
            if active_operation.progress_text:
                lines.append(truncate_text(active_operation.progress_text, columns))
            if active_operation.phase == "conflict" and active_operation.action == "move":
                footer = fit_footer("R renomear | Esc cancelar", columns, "conflict")
            else:
                context = "conflict" if active_operation.phase == "conflict" else "confirmation"
                footer = build_footer(columns, context)
            lines.append(footer)
        else:
            has_filter = bool(state.search_query)
            has_status = bool(state.status_message)
            item_rows = max(
                1,
                min(8, rows - 1 - 1 - int(has_filter) - 1 - int(has_status)),
            )
            lines, state.selected_idx, state.scroll_offset = build_ui_lines(
                state.current_path,
                state.filtered_dirs,
                state.selected_idx,
                state.scroll_offset,
                item_rows,
                columns,
                state.search_query,
                footer_text=build_footer(
                    columns,
                    show_files=state.show_files,
                    show_hidden_files=state.show_hidden_files,
                ),
                status_message=state.status_message,
            )
        render_lines(lines, rows)

    def check_operation_cancelled():
        if active_operation is None or active_operation.cancel_requested:
            return active_operation is not None and active_operation.cancel_requested
        try:
            available = msvcrt.kbhit() if IS_WINDOWS else bool(select.select([fd], [], [], 0)[0])
            if available:
                key = read_key(fd, timeout=0)
                if key in ("ESC", "\x03"):
                    active_operation.cancel_requested = True
        except (OSError, ValueError, TypeError):
            pass
        return active_operation.cancel_requested

    def operation_progress(path, copied, total):
        if active_operation is None:
            return
        active_operation.progress_text = (
            f"Copiando {sanitize_terminal_text(os.path.basename(path))}: {copied}/{total} bytes"
        )
        now = time.monotonic()
        if copied == total or now - active_operation._last_progress_redraw >= 0.2:
            active_operation._last_progress_redraw = now
            render_current()

    def sigint_handler(signum, frame):
        if active_operation is not None:
            active_operation.cancel_requested = True
            return
        state.cancelled = True
        state.finished = True
        clear_ui()
        if not IS_WINDOWS and old_settings is not None:
            with contextlib.suppress(OSError, Exception):
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        sys.exit(130)

    signal.signal(signal.SIGINT, sigint_handler)

    try:
        if not IS_WINDOWS and fd is not None:
            tty.setraw(fd)
            termios.tcflush(fd, termios.TCIFLUSH)
        ui_out.write("\033[?25l")  # Esconde cursor
        ui_out.flush()

        while not state.finished:
            term_size = shutil.get_terminal_size((80, 24))
            render_current(term_size)

            if test_key_queue is not None:
                key = test_key_queue.pop(0) if test_key_queue else "ESC"
            else:
                key = read_key(fd, timeout=0.2)
                if key is None:
                    continue

            if help_visible:
                if key in ("F1", "ESC", "\x03"):
                    help_visible = False
                continue

            if active_operation is not None:
                active_operation.handle_key(key)
                if active_operation.done:
                    state.status_message = active_operation.message
                    state.refresh_dirs()
                    active_operation = None
                elif active_operation.phase == "running":
                    active_operation.execute(
                        progress=operation_progress,
                        cancel=check_operation_cancelled,
                    )
                    if active_operation.done:
                        state.status_message = active_operation.message
                        state.refresh_dirs()
                        active_operation = None
                continue

            if key == "F1":
                help_visible = True
            elif key in ("F5", "F6", "DELETE"):
                action = {"F5": "copy", "F6": "move", "DELETE": "delete"}[key]
                try:
                    active_operation = FileOperationController(state, action)
                except (OSError, OperationError) as exc:
                    state.status_message = str(exc)
            else:
                state.handle_key(key)

    except KeyboardInterrupt:
        if active_operation is not None:
            active_operation.cancel_requested = True
            state.status_message = "Operacao cancelada; finalizando a limpeza segura."
        else:
            state.cancelled = True
    finally:
        if not IS_WINDOWS and old_settings is not None:
            with contextlib.suppress(OSError, Exception):
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        clear_ui()

        if (
            not state.cancelled
            and state.target_path
            and not write_output(
                state.target_path,
                cwd_file,
                cmd_escape="--cmd-cwd-file" in sys.argv,
            )
        ):
            sys.exit(1)


if __name__ == "__main__":
    main()
